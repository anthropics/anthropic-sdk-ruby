# typed: strong

module Anthropic
  module Models
    # The file has `downloadable: false`. Only files generated by a tool, such as the
    # code execution tool, can be downloaded.
    class FileNotDownloadableError < Anthropic::Errors::BadRequestError
      sig { returns(Symbol) }
      def error_code
      end

      sig { returns(Anthropic::FileNotDownloadableErrorDetails) }
      def details
      end
    end
  end
end
