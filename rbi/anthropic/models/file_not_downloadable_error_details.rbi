# typed: strong

module Anthropic
  module Models
    class FileNotDownloadableErrorDetails < Anthropic::Internal::Type::BaseModel
      OrHash =
        T.type_alias do
          T.any(
            Anthropic::FileNotDownloadableErrorDetails,
            Anthropic::Internal::AnyHash
          )
        end

      sig { returns(Symbol) }
      attr_accessor :error_code

      # The file has `downloadable: false`. Only files generated by a tool, such as the
      # code execution tool, can be downloaded.
      sig { params(error_code: Symbol).returns(T.attached_class) }
      def self.new(error_code: :file_not_downloadable)
      end

      sig { override.returns({ error_code: Symbol }) }
      def to_hash
      end
    end
  end
end
