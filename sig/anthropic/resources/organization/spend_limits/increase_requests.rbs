module Anthropic
  module Resources
    class Organization
      class SpendLimits
        class IncreaseRequests
          def retrieve: (
            String spend_limit_increase_request_id,
            ?request_options: Anthropic::request_opts
          ) -> Anthropic::Organization::SpendLimits::SpendLimitIncreaseRequest

          def list: (
            ?actor_ids: ::Array[String]?,
            ?limit: Integer,
            ?page: String?,
            ?status: ::Array[Anthropic::Models::Organization::SpendLimits::spend_limit_increase_request_status]?,
            ?request_options: Anthropic::request_opts
          ) -> Anthropic::Internal::PageCursor[Anthropic::Organization::SpendLimits::SpendLimitIncreaseRequest]

          def approve: (
            String spend_limit_increase_request_id,
            amount: String,
            ?period: Anthropic::Models::Organization::spend_limit_period?,
            ?suppress_notification: bool,
            ?request_options: Anthropic::request_opts
          ) -> Anthropic::Models::Organization::SpendLimits::IncreaseRequestApproveResponse

          def deny: (
            String spend_limit_increase_request_id,
            ?suppress_notification: bool,
            ?request_options: Anthropic::request_opts
          ) -> Anthropic::Organization::SpendLimits::SpendLimitIncreaseRequest

          def initialize: (client: Anthropic::Client) -> void
        end
      end
    end
  end
end
