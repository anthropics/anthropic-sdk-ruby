module Anthropic
  module Resources
    class Organization
      class Invites
        def create: (
          email: String,
          role: Anthropic::Models::Organization::InviteCreateParams::role,
          ?rbac_group_ids: ::Array[String],
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::OrganizationInvite

        def retrieve: (
          String invite_id,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::OrganizationInvite

        def list: (
          ?after_id: String,
          ?before_id: String,
          ?email: String,
          ?limit: Integer,
          ?roles: ::Array[String],
          ?statuses: ::Array[Anthropic::Models::Organization::InviteListParams::status],
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Internal::Page[Anthropic::Organization::OrganizationInvite]

        def delete: (
          String invite_id,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Models::Organization::InviteDeleteResponse

        def initialize: (client: Anthropic::Client) -> void
      end
    end
  end
end
