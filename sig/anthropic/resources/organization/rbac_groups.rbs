module Anthropic
  module Resources
    class Organization
      class RBACGroups
        attr_reader members: Anthropic::Resources::Organization::RBACGroups::Members

        def create: (
          name: String,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::RBACGroup

        def retrieve: (
          String rbac_group_id,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::RBACGroup

        def update: (
          String rbac_group_id,
          ?name: String?,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::RBACGroup

        def list: (
          ?limit: Integer,
          ?page: String?,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Internal::PageCursor[Anthropic::Organization::RBACGroup]

        def delete: (
          String rbac_group_id,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Organization::DeletedRBACGroup

        def initialize: (client: Anthropic::Client) -> void
      end
    end
  end
end
