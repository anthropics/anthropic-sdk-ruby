            ?description: String,
            ?name: String,
            ?betas: ::Array[Anthropic::Models::anthropic_beta],
            ?request_options: Anthropic::request_opts
          ) -> Anthropic::Beta::Organization::BetaNewOrganizationWebhookEndpoint

          def retrieve: (
