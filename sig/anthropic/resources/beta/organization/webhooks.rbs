          ) -> Anthropic::Beta::Organization::BetaOrganizationWebhookEndpoint

          def update: (
            String webhook_endpoint_id,
            ?description: String,
            ?enabled_events: ::Array[Anthropic::Models::Beta::Organization::WebhookUpdateParams::enabled_event],
