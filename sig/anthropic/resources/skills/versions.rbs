module Anthropic
  module Resources
    class Skills
      class Versions
        def create: (
          String skill_id,
          files: ::Array[Anthropic::Internal::file_input],
          ?workspace_id: String,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Skills::SkillVersion

        def retrieve: (
          String version,
          skill_id: String,
          ?workspace_id: String,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Skills::SkillVersion

        def list: (
          String skill_id,
          ?limit: Integer?,
          ?page: String?,
          ?workspace_id: String,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Internal::PageCursor[Anthropic::Skills::SkillVersion]

        def delete: (
          String version,
          skill_id: String,
          ?workspace_id: String,
          ?request_options: Anthropic::request_opts
        ) -> Anthropic::Skills::DeletedSkillVersion

        def initialize: (client: Anthropic::Client) -> void
      end
    end
  end
end
