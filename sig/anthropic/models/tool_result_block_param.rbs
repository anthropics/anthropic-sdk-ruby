module Anthropic
  module Models
    type tool_result_block_param =
      {
        tool_use_id: String,
        type: :tool_result,
        cache_control: Anthropic::CacheControlEphemeral?,
        content: Anthropic::Models::ToolResultBlockParam::content,
        is_error: bool,
        toolset_name: String?
      }

    class ToolResultBlockParam < Anthropic::Internal::Type::BaseModel
      attr_accessor tool_use_id: String

      attr_accessor type: :tool_result

      attr_accessor cache_control: Anthropic::CacheControlEphemeral?

      attr_reader content: Anthropic::Models::ToolResultBlockParam::content?

      def content=: (
        Anthropic::Models::ToolResultBlockParam::content
      ) -> Anthropic::Models::ToolResultBlockParam::content

      attr_reader is_error: bool?

      def is_error=: (bool) -> bool

      attr_accessor toolset_name: String?

      def initialize: (
        tool_use_id: String,
        ?cache_control: Anthropic::CacheControlEphemeral?,
        ?content: Anthropic::Models::ToolResultBlockParam::content,
        ?is_error: bool,
        ?toolset_name: String?,
        ?type: :tool_result
      ) -> void

      def to_hash: -> {
        tool_use_id: String,
        type: :tool_result,
        cache_control: Anthropic::CacheControlEphemeral?,
        content: Anthropic::Models::ToolResultBlockParam::content,
        is_error: bool,
        toolset_name: String?
      }

      type content =
        String
        | ::Array[Anthropic::Models::ToolResultBlockParam::Content::content]

      module Content
        extend Anthropic::Internal::Type::Union

        type content =
          Anthropic::TextBlockParam
          | Anthropic::ImageBlockParam
          | Anthropic::SearchResultBlockParam
          | Anthropic::DocumentBlockParam
          | Anthropic::ToolReferenceBlockParam
          | Anthropic::BrowserStateBlockParam

        module Content
          extend Anthropic::Internal::Type::Union

          def self?.variants: -> ::Array[Anthropic::Models::ToolResultBlockParam::Content::content]

          def self.new:
            (
              type: :text | "text",
              text: String,
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?citations: ::Array[Anthropic::Models::text_citation_param]?
            ) -> Anthropic::TextBlockParam
            | (
              type: :image | "image",
              source: Anthropic::Models::ImageBlockParam::source,
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?transformations: Anthropic::ImageTransformationsParam?
            ) -> Anthropic::ImageBlockParam
            | (
              type: :search_result | "search_result",
              content: ::Array[Anthropic::TextBlockParam],
              source: String,
              title: String,
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?citations: Anthropic::CitationsConfigParam
            ) -> Anthropic::SearchResultBlockParam
            | (
              type: :document | "document",
              source: Anthropic::Models::DocumentBlockParam::source,
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?citations: Anthropic::CitationsConfigParam?,
              ?context: String?,
              ?title: String?
            ) -> Anthropic::DocumentBlockParam
            | (
              type: :tool_reference | "tool_reference",
              tool_name: String,
              ?cache_control: Anthropic::CacheControlEphemeral?
            ) -> Anthropic::ToolReferenceBlockParam
            | (
              type: :browser_state | "browser_state",
              tabs: ::Array[Anthropic::BrowserStateTabEntry],
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?state_changes: ::Array[Anthropic::Models::browser_state_change]?
            ) -> Anthropic::BrowserStateBlockParam
            | (
              type: Symbol | String,
              ?text: String,
              ?cache_control: Anthropic::CacheControlEphemeral?,
              ?citations: ::Array[Anthropic::Models::text_citation_param]?
              | Anthropic::CitationsConfigParam
              | Anthropic::CitationsConfigParam?,
              ?source: Anthropic::Models::ImageBlockParam::source
              | String
              | Anthropic::Models::DocumentBlockParam::source,
              ?transformations: Anthropic::ImageTransformationsParam?,
              ?content: ::Array[Anthropic::TextBlockParam],
              ?title: String | String?,
              ?context: String?,
              ?tool_name: String,
              ?tabs: ::Array[Anthropic::BrowserStateTabEntry],
              ?state_changes: ::Array[Anthropic::Models::browser_state_change]?
            ) -> Anthropic::Models::ToolResultBlockParam::Content::content
        end

        def self?.variants: -> ::Array[Anthropic::Models::ToolResultBlockParam::content]

        ContentArray: Anthropic::Internal::Type::Converter
      end
    end
  end
end
