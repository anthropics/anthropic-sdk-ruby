        NAVIGATE: :navigate
        LIST_TABS: :list_tabs
        NEW_TAB: :new_tab
        SWITCH_TAB: :switch_tab
        CLOSE_TAB: :close_tab
        READ_PAGE: :read_page
        GET_PAGE_TEXT: :get_page_text
