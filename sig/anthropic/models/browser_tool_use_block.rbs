        SCROLL: :scroll
        TYPE: :type
        KEY: :key
        HOLD_KEY: :hold_key
        WAIT: :wait
        JAVASCRIPT_EXEC: :javascript_exec

        def self?.values: -> ::Array[Anthropic::Models::BrowserToolUseBlock::name_]
      end

      def self?.variants: -> ::Array[Anthropic::Models::browser_tool_use_block]

