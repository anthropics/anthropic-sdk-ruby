module Anthropic
  module Models
    module MessageBatchResult = Messages::MessageBatchResult

    module Messages
      type message_batch_result =
        Anthropic::Messages::MessageBatchSucceededResult
        | Anthropic::Messages::MessageBatchErroredResult
        | Anthropic::Messages::MessageBatchCanceledResult
        | Anthropic::Messages::MessageBatchExpiredResult

      module MessageBatchResult
        extend Anthropic::Internal::Type::Union

        type type_ = :succeeded | :errored | :canceled | :expired

        module Type
          extend Anthropic::Internal::Type::Enum

          SUCCEEDED: :succeeded
          ERRORED: :errored
          CANCELED: :canceled
          EXPIRED: :expired

          def self?.values: -> ::Array[Anthropic::Models::Messages::MessageBatchResult::type_]
        end

        def self?.variants: -> ::Array[Anthropic::Models::Messages::message_batch_result]

        def self.new:
          (
            type: :succeeded | "succeeded",
            message: Anthropic::Message
          ) -> Anthropic::Messages::MessageBatchSucceededResult
          | (
            type: :errored | "errored",
            error: Anthropic::ErrorResponse
          ) -> Anthropic::Messages::MessageBatchErroredResult
          | (
            type: :canceled | "canceled"
          ) -> Anthropic::Messages::MessageBatchCanceledResult
          | (
            type: :expired | "expired"
          ) -> Anthropic::Messages::MessageBatchExpiredResult
          | (
            type: Symbol | String,
            ?message: Anthropic::Message,
            ?error: Anthropic::ErrorResponse
          ) -> Anthropic::Models::Messages::message_batch_result
      end
    end
  end
end
