module Anthropic
  module Models
    type user_profile =
      {
        id: String,
        access_type: Anthropic::Models::user_profile_access_type,
        created_at: Time,
        external_user_details: Anthropic::UserProfileExternalUserDetails,
        metadata: ::Hash[Symbol, String],
        name: String?,
        programs: Anthropic::UserProfilePrograms,
        type: :user_profile,
        updated_at: Time
      }

    class UserProfile < Anthropic::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor access_type: Anthropic::Models::user_profile_access_type

      attr_accessor created_at: Time

      attr_accessor external_user_details: Anthropic::UserProfileExternalUserDetails

      attr_accessor metadata: ::Hash[Symbol, String]

      attr_accessor name: String?

      attr_accessor programs: Anthropic::UserProfilePrograms

      attr_accessor type: :user_profile

      attr_accessor updated_at: Time

      def initialize: (
        id: String,
        access_type: Anthropic::Models::user_profile_access_type,
        created_at: Time,
        external_user_details: Anthropic::UserProfileExternalUserDetails,
        metadata: ::Hash[Symbol, String],
        name: String?,
        programs: Anthropic::UserProfilePrograms,
        updated_at: Time,
        ?type: :user_profile
      ) -> void

      def to_hash: -> {
        id: String,
        access_type: Anthropic::Models::user_profile_access_type,
        created_at: Time,
        external_user_details: Anthropic::UserProfileExternalUserDetails,
        metadata: ::Hash[Symbol, String],
        name: String?,
        programs: Anthropic::UserProfilePrograms,
        type: :user_profile,
        updated_at: Time
      }
    end
  end
end
