module Anthropic
  module Models
    type user_profile_enforcement_action_reason =
      :unsupported_region
      | :fraud_or_abuse
      | :high_harm
      | :usage_policy_violation
      | :account_compromise
      | :unspecified

    module UserProfileEnforcementActionReason
      extend Anthropic::Internal::Type::Enum

      UNSUPPORTED_REGION: :unsupported_region
      FRAUD_OR_ABUSE: :fraud_or_abuse
      HIGH_HARM: :high_harm
      USAGE_POLICY_VIOLATION: :usage_policy_violation
      ACCOUNT_COMPROMISE: :account_compromise
      UNSPECIFIED: :unspecified

      def self?.values: -> ::Array[Anthropic::Models::user_profile_enforcement_action_reason]
    end
  end
end
