module Anthropic
  module Models
    type diagnostics =
      { cache_miss_reason: Anthropic::Models::cache_miss_reason? }

    class Diagnostics < Anthropic::Internal::Type::BaseModel
      attr_accessor cache_miss_reason: Anthropic::Models::cache_miss_reason?

      def initialize: (
        cache_miss_reason: Anthropic::Models::cache_miss_reason?
      ) -> void

      def to_hash: -> {
        cache_miss_reason: Anthropic::Models::cache_miss_reason?
      }
    end
  end
end
