module Anthropic
  module Models
    type content_block_param =
      Anthropic::TextBlockParam
      | Anthropic::ImageBlockParam
      | Anthropic::DocumentBlockParam
      | Anthropic::SearchResultBlockParam
      | Anthropic::ThinkingBlockParam
      | Anthropic::RedactedThinkingBlockParam
      | Anthropic::ToolUseBlockParam
      | Anthropic::ToolResultBlockParam
      | Anthropic::ServerToolUseBlockParam
      | Anthropic::WebSearchToolResultBlockParam
      | Anthropic::WebFetchToolResultBlockParam
      | Anthropic::CodeExecutionToolResultBlockParam
      | Anthropic::BashCodeExecutionToolResultBlockParam
      | Anthropic::TextEditorCodeExecutionToolResultBlockParam
      | Anthropic::ToolSearchToolResultBlockParam
      | Anthropic::ContainerUploadBlockParam

    module ContentBlockParam
      extend Anthropic::Internal::Type::Union

      type type_ =
        :text
        | :image
        | :document
        | :search_result
        | :thinking
        | :redacted_thinking
        | :tool_use
        | :tool_result
        | :server_tool_use
        | :web_search_tool_result
        | :web_fetch_tool_result
        | :code_execution_tool_result
        | :bash_code_execution_tool_result
        | :text_editor_code_execution_tool_result
        | :tool_search_tool_result
        | :container_upload

      module Type
        extend Anthropic::Internal::Type::Enum

        TEXT: :text
        IMAGE: :image
        DOCUMENT: :document
        SEARCH_RESULT: :search_result
        THINKING: :thinking
        REDACTED_THINKING: :redacted_thinking
        TOOL_USE: :tool_use
        TOOL_RESULT: :tool_result
        SERVER_TOOL_USE: :server_tool_use
        WEB_SEARCH_TOOL_RESULT: :web_search_tool_result
        WEB_FETCH_TOOL_RESULT: :web_fetch_tool_result
        CODE_EXECUTION_TOOL_RESULT: :code_execution_tool_result
        BASH_CODE_EXECUTION_TOOL_RESULT: :bash_code_execution_tool_result
        TEXT_EDITOR_CODE_EXECUTION_TOOL_RESULT: :text_editor_code_execution_tool_result
        TOOL_SEARCH_TOOL_RESULT: :tool_search_tool_result
        CONTAINER_UPLOAD: :container_upload

        def self?.values: -> ::Array[Anthropic::Models::ContentBlockParam::type_]
      end

      def self?.variants: -> ::Array[Anthropic::Models::content_block_param]

      def self.new:
        (
          type: :text | "text",
          text: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?citations: ::Array[Anthropic::Models::text_citation_param]?
        ) -> Anthropic::TextBlockParam
        | (
          type: :image | "image",
          source: Anthropic::Models::ImageBlockParam::source,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?transformations: Anthropic::ImageTransformationsParam?
        ) -> Anthropic::ImageBlockParam
        | (
          type: :document | "document",
          source: Anthropic::Models::DocumentBlockParam::source,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?citations: Anthropic::CitationsConfigParam?,
          ?context: String?,
          ?title: String?
        ) -> Anthropic::DocumentBlockParam
        | (
          type: :search_result | "search_result",
          content: ::Array[Anthropic::TextBlockParam],
          source: String,
          title: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?citations: Anthropic::CitationsConfigParam
        ) -> Anthropic::SearchResultBlockParam
        | (
          type: :thinking | "thinking",
          signature: String,
          thinking: String
        ) -> Anthropic::ThinkingBlockParam
        | (
          type: :redacted_thinking | "redacted_thinking",
          data: String
        ) -> Anthropic::RedactedThinkingBlockParam
        | (
          type: :tool_use | "tool_use",
          id: String,
          input: ::Hash[Symbol, top],
          name: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?caller_: Anthropic::Models::ToolUseBlockParam::caller_,
          ?toolset_name: String?
        ) -> Anthropic::ToolUseBlockParam
        | (
          type: :tool_result | "tool_result",
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?content: Anthropic::Models::ToolResultBlockParam::content,
          ?is_error: bool,
          ?toolset_name: String?
        ) -> Anthropic::ToolResultBlockParam
        | (
          type: :server_tool_use | "server_tool_use",
          id: String,
          input: ::Hash[Symbol, top],
          name: Anthropic::Models::ServerToolUseBlockParam::name_,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?caller_: Anthropic::Models::ServerToolUseBlockParam::caller_
        ) -> Anthropic::ServerToolUseBlockParam
        | (
          type: :web_search_tool_result | "web_search_tool_result",
          content: Anthropic::Models::web_search_tool_result_block_param_content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?caller_: Anthropic::Models::WebSearchToolResultBlockParam::caller_
        ) -> Anthropic::WebSearchToolResultBlockParam
        | (
          type: :web_fetch_tool_result | "web_fetch_tool_result",
          content: Anthropic::Models::WebFetchToolResultBlockParam::content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?caller_: Anthropic::Models::WebFetchToolResultBlockParam::caller_
        ) -> Anthropic::WebFetchToolResultBlockParam
        | (
          type: :code_execution_tool_result | "code_execution_tool_result",
          content: Anthropic::Models::code_execution_tool_result_block_param_content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?
        ) -> Anthropic::CodeExecutionToolResultBlockParam
        | (
          type: :bash_code_execution_tool_result
          | "bash_code_execution_tool_result",
          content: Anthropic::Models::BashCodeExecutionToolResultBlockParam::content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?
        ) -> Anthropic::BashCodeExecutionToolResultBlockParam
        | (
          type: :text_editor_code_execution_tool_result
          | "text_editor_code_execution_tool_result",
          content: Anthropic::Models::TextEditorCodeExecutionToolResultBlockParam::content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?
        ) -> Anthropic::TextEditorCodeExecutionToolResultBlockParam
        | (
          type: :tool_search_tool_result | "tool_search_tool_result",
          content: Anthropic::Models::ToolSearchToolResultBlockParam::content,
          tool_use_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?
        ) -> Anthropic::ToolSearchToolResultBlockParam
        | (
          type: :container_upload | "container_upload",
          file_id: String,
          ?cache_control: Anthropic::CacheControlEphemeral?
        ) -> Anthropic::ContainerUploadBlockParam
        | (
          type: Symbol | String,
          ?text: String,
          ?cache_control: Anthropic::CacheControlEphemeral?,
          ?citations: ::Array[Anthropic::Models::text_citation_param]?
          | Anthropic::CitationsConfigParam?
          | Anthropic::CitationsConfigParam,
          ?source: Anthropic::Models::ImageBlockParam::source
          | Anthropic::Models::DocumentBlockParam::source
          | String,
          ?transformations: Anthropic::ImageTransformationsParam?,
          ?context: String?,
          ?title: String? | String,
          ?content: ::Array[Anthropic::TextBlockParam]
          | Anthropic::Models::ToolResultBlockParam::content
          | Anthropic::Models::web_search_tool_result_block_param_content
          | Anthropic::Models::WebFetchToolResultBlockParam::content
          | Anthropic::Models::code_execution_tool_result_block_param_content
          | Anthropic::Models::BashCodeExecutionToolResultBlockParam::content
          | Anthropic::Models::TextEditorCodeExecutionToolResultBlockParam::content
          | Anthropic::Models::ToolSearchToolResultBlockParam::content,
          ?signature: String,
          ?thinking: String,
          ?data: String,
          ?id: String,
          ?input: ::Hash[Symbol, top],
          ?name: String | Anthropic::Models::ServerToolUseBlockParam::name_,
          ?caller_: Anthropic::Models::ToolUseBlockParam::caller_
          | Anthropic::Models::ServerToolUseBlockParam::caller_
          | Anthropic::Models::WebSearchToolResultBlockParam::caller_
          | Anthropic::Models::WebFetchToolResultBlockParam::caller_,
          ?toolset_name: String?,
          ?tool_use_id: String,
          ?is_error: bool,
          ?file_id: String
        ) -> Anthropic::Models::content_block_param
    end
  end
end
