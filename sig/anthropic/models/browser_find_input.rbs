module Anthropic
  module Models
    type browser_find_input = { query: String, tab_id: String? }

    class BrowserFindInput < Anthropic::Internal::Type::BaseModel
      attr_accessor query: String

      attr_accessor tab_id: String?

      def initialize: (query: String, ?tab_id: String?) -> void

      def to_hash: -> { query: String, tab_id: String? }
    end
  end
end
