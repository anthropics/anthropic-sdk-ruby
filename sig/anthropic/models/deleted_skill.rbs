module Anthropic
  module Models
    type deleted_skill = { id: String, type: :skill_deleted }

    class DeletedSkill < Anthropic::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor type: :skill_deleted

      def initialize: (id: String, ?type: :skill_deleted) -> void

      def to_hash: -> { id: String, type: :skill_deleted }
    end
  end
end
