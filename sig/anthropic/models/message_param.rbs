module Anthropic
  module Models
    type message_param =
      Anthropic::UserMessageParam
      | Anthropic::AssistantMessageParam
      | Anthropic::SystemMessageParam

    module MessageParam
      extend Anthropic::Internal::Type::Union

      type role = :user | :assistant | :system

      module Role
        extend Anthropic::Internal::Type::Enum

        USER: :user
        ASSISTANT: :assistant
        SYSTEM: :system

        def self?.values: -> ::Array[Anthropic::Models::MessageParam::role]
      end

      def self?.variants: -> ::Array[Anthropic::Models::message_param]

      def self.new:
        (
          role: :user | "user",
          content: Anthropic::Models::message_content_param
        ) -> Anthropic::UserMessageParam
        | (
          role: :assistant | "assistant",
          content: Anthropic::Models::message_content_param
        ) -> Anthropic::AssistantMessageParam
        | (
          role: :system | "system",
          content: Anthropic::Models::SystemMessageParam::content
        ) -> Anthropic::SystemMessageParam
        | (
          role: Anthropic::Models::MessageParam::role | String,
          content: Anthropic::Models::message_content_param
          | Anthropic::Models::SystemMessageParam::content
        ) -> Anthropic::Models::message_param
    end
  end
end
