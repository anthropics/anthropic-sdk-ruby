module Anthropic
  module Models
    type file_metadata =
      {
        id: String,
        created_at: Time,
        filename: String,
        mime_type: String,
        size_bytes: Integer,
        type: :file,
        downloadable: bool,
        expires_at: Time?
      }

    class FileMetadata < Anthropic::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor filename: String

      attr_accessor mime_type: String

      attr_accessor size_bytes: Integer

      attr_accessor type: :file

      attr_reader downloadable: bool?

      def downloadable=: (bool) -> bool

      attr_accessor expires_at: Time?

      def initialize: (
        id: String,
        created_at: Time,
        filename: String,
        mime_type: String,
        size_bytes: Integer,
        ?downloadable: bool,
        ?expires_at: Time?,
        ?type: :file
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        filename: String,
        mime_type: String,
        size_bytes: Integer,
        type: :file,
        downloadable: bool,
        expires_at: Time?
      }
    end
  end
end
