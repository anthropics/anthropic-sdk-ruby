module Anthropic
  module Models
    type image_block_param =
      {
        source: Anthropic::Models::ImageBlockParam::source,
        type: :image,
        cache_control: Anthropic::CacheControlEphemeral?,
        transformations: Anthropic::ImageTransformationsParam?
      }

    class ImageBlockParam < Anthropic::Internal::Type::BaseModel
      attr_accessor source: Anthropic::Models::ImageBlockParam::source

      attr_accessor type: :image

      attr_accessor cache_control: Anthropic::CacheControlEphemeral?

      attr_accessor transformations: Anthropic::ImageTransformationsParam?

      def initialize: (
        source: Anthropic::Models::ImageBlockParam::source,
        ?cache_control: Anthropic::CacheControlEphemeral?,
        ?transformations: Anthropic::ImageTransformationsParam?,
        ?type: :image
      ) -> void

      def to_hash: -> {
        source: Anthropic::Models::ImageBlockParam::source,
        type: :image,
        cache_control: Anthropic::CacheControlEphemeral?,
        transformations: Anthropic::ImageTransformationsParam?
      }

      type source =
        Anthropic::Base64ImageSource
        | Anthropic::URLImageSource
        | Anthropic::FileImageSource

      module Source
        extend Anthropic::Internal::Type::Union

        def self?.variants: -> ::Array[Anthropic::Models::ImageBlockParam::source]

        def self.new:
          (
            type: :base64 | "base64",
            data: String,
            media_type: Anthropic::Models::Base64ImageSource::media_type
          ) -> Anthropic::Base64ImageSource
          | (type: :url | "url", url: String) -> Anthropic::URLImageSource
          | (
            type: :file | "file",
            file_id: String
          ) -> Anthropic::FileImageSource
          | (
            type: Symbol | String,
            ?data: String,
            ?media_type: Anthropic::Models::Base64ImageSource::media_type,
            ?url: String,
            ?file_id: String
          ) -> Anthropic::Models::ImageBlockParam::source
      end
    end
  end
end
