module Anthropic
  module Models
    module Organization
      module Workspaces
        type service_account_retrieve_params =
          { workspace_id: String, service_account_id: String }
          & Anthropic::Internal::Type::request_parameters

        class ServiceAccountRetrieveParams < Anthropic::Internal::Type::BaseModel
          extend Anthropic::Internal::Type::RequestParameters::Converter
          include Anthropic::Internal::Type::RequestParameters

          attr_accessor workspace_id: String

          attr_accessor service_account_id: String

          def initialize: (
            workspace_id: String,
            service_account_id: String,
            ?request_options: Anthropic::request_opts
          ) -> void

          def to_hash: -> {
            workspace_id: String,
            service_account_id: String,
            request_options: Anthropic::RequestOptions
          }
        end
      end
    end
  end
end
