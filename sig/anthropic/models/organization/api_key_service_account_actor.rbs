module Anthropic
  module Models
    module Organization
      type api_key_service_account_actor =
        { service_account_id: String, type: :service_account_actor }

      class APIKeyServiceAccountActor < Anthropic::Internal::Type::BaseModel
        attr_accessor service_account_id: String

        attr_accessor type: :service_account_actor

        def initialize: (
          service_account_id: String,
          ?type: :service_account_actor
        ) -> void

        def to_hash: -> {
          service_account_id: String,
          type: :service_account_actor
        }
      end
    end
  end
end
