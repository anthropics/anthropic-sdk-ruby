module Anthropic
  module Models
    module Organization
      type analytics_claude_tag_metrics =
        { active_day_count: Integer?, active_message_count: Integer? }

      class AnalyticsClaudeTagMetrics < Anthropic::Internal::Type::BaseModel
        attr_accessor active_day_count: Integer?

        attr_accessor active_message_count: Integer?

        def initialize: (
          active_day_count: Integer?,
          active_message_count: Integer?
        ) -> void

        def to_hash: -> {
          active_day_count: Integer?,
          active_message_count: Integer?
        }
      end
    end
  end
end
