module Anthropic
  module Models
    module Organization
      module RBACGroups
        type deleted_rbac_group_member =
          {
            rbac_group_id: String,
            type: :rbac_group_member_deleted,
            user_id: String
          }

        class DeletedRBACGroupMember < Anthropic::Internal::Type::BaseModel
          attr_accessor rbac_group_id: String

          attr_accessor type: :rbac_group_member_deleted

          attr_accessor user_id: String

          def initialize: (
            rbac_group_id: String,
            user_id: String,
            ?type: :rbac_group_member_deleted
          ) -> void

          def to_hash: -> {
            rbac_group_id: String,
            type: :rbac_group_member_deleted,
            user_id: String
          }
        end
      end
    end
  end
end
