module Anthropic
  module Models
    module Organization
      type spend_summary =
        {
          actor: Anthropic::Models::Organization::SpendSummary::actor,
          amount: String?,
          currency: String,
          period: Anthropic::Models::Organization::spend_limit_period,
          period_to_date_spend: String,
          scope: Anthropic::Models::Organization::SpendSummary::scope,
          source: Anthropic::Models::Organization::SpendSummary::source,
          spend_limit_id: String
        }

      class SpendSummary < Anthropic::Internal::Type::BaseModel
        attr_accessor actor: Anthropic::Models::Organization::SpendSummary::actor

        attr_accessor amount: String?

        attr_accessor currency: String

        attr_accessor period: Anthropic::Models::Organization::spend_limit_period

        attr_accessor period_to_date_spend: String

        attr_accessor scope: Anthropic::Models::Organization::SpendSummary::scope

        attr_accessor source: Anthropic::Models::Organization::SpendSummary::source

        attr_accessor spend_limit_id: String

        def initialize: (
          actor: Anthropic::Models::Organization::SpendSummary::actor,
          amount: String?,
          currency: String,
          period: Anthropic::Models::Organization::spend_limit_period,
          period_to_date_spend: String,
          scope: Anthropic::Models::Organization::SpendSummary::scope,
          source: Anthropic::Models::Organization::SpendSummary::source,
          spend_limit_id: String
        ) -> void

        def to_hash: -> {
          actor: Anthropic::Models::Organization::SpendSummary::actor,
          amount: String?,
          currency: String,
          period: Anthropic::Models::Organization::spend_limit_period,
          period_to_date_spend: String,
          scope: Anthropic::Models::Organization::SpendSummary::scope,
          source: Anthropic::Models::Organization::SpendSummary::source,
          spend_limit_id: String
        }

        type actor =
          Anthropic::Organization::SpendLimitUserActor
          | Anthropic::Organization::SpendLimitScopedAPIKeyActor

        module Actor
          extend Anthropic::Internal::Type::Union

          type type_ = :user_actor | :scoped_api_key_actor

          module Type
            extend Anthropic::Internal::Type::Enum

            USER_ACTOR: :user_actor
            SCOPED_API_KEY_ACTOR: :scoped_api_key_actor

            def self?.values: -> ::Array[Anthropic::Models::Organization::SpendSummary::Actor::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Organization::SpendSummary::actor]

          def self.new:
            (
              type: :user_actor | "user_actor",
              deleted: bool,
              email_address: String?,
              name: String?,
              user_id: String
            ) -> Anthropic::Organization::SpendLimitUserActor
            | (
              type: :scoped_api_key_actor | "scoped_api_key_actor",
              scoped_api_key_id: String
            ) -> Anthropic::Organization::SpendLimitScopedAPIKeyActor
            | (
              type: Anthropic::Models::Organization::SpendSummary::Actor::type_
              | String,
              ?deleted: bool,
              ?email_address: String?,
              ?name: String?,
              ?user_id: String,
              ?scoped_api_key_id: String
            ) -> Anthropic::Models::Organization::SpendSummary::actor
        end

        type scope =
          Anthropic::Organization::SpendLimitUserScope
          | Anthropic::Organization::SpendLimitSeatTierScope
          | Anthropic::Organization::SpendLimitRBACGroupScope
          | Anthropic::Organization::SpendLimitOrganizationServiceScope
          | Anthropic::Organization::SpendLimitOrganizationScope
          | Anthropic::Organization::SpendLimitWorkspaceScope
          | Anthropic::Organization::SpendLimitUsageTierScope

