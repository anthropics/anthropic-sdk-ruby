          extend Anthropic::Internal::Type::Union

          type type_ =
            :user
            | :seat_tier
            | :rbac_group
            | :organization_service
            | :organization
            | :workspace
            | :usage_tier

          module Type
            extend Anthropic::Internal::Type::Enum

            USER: :user
            SEAT_TIER: :seat_tier
            RBAC_GROUP: :rbac_group
            ORGANIZATION_SERVICE: :organization_service
            ORGANIZATION: :organization
            WORKSPACE: :workspace
            USAGE_TIER: :usage_tier

            def self?.values: -> ::Array[Anthropic::Models::Organization::SpendSummary::Scope::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Organization::SpendSummary::scope]

          def self.new:
            (
              type: :user | "user",
              user_id: String
            ) -> Anthropic::Organization::SpendLimitUserScope
            | (
              type: :seat_tier | "seat_tier",
              seat_tier: String
            ) -> Anthropic::Organization::SpendLimitSeatTierScope
            | (
              type: :rbac_group | "rbac_group",
              rbac_group_id: String
            ) -> Anthropic::Organization::SpendLimitRBACGroupScope
            | (
              type: :organization_service | "organization_service",
              service: String
            ) -> Anthropic::Organization::SpendLimitOrganizationServiceScope
            | (
              type: :organization | "organization"
            ) -> Anthropic::Organization::SpendLimitOrganizationScope
            | (
              type: :workspace | "workspace",
              workspace_id: String
            ) -> Anthropic::Organization::SpendLimitWorkspaceScope
            | (
              type: :usage_tier | "usage_tier"
            ) -> Anthropic::Organization::SpendLimitUsageTierScope
            | (
              type: Anthropic::Models::Organization::SpendSummary::Scope::type_
              | String,
              ?user_id: String,
              ?seat_tier: String,
              ?rbac_group_id: String,
              ?service: String,
              ?workspace_id: String
            ) -> Anthropic::Models::Organization::SpendSummary::scope
        end

        type source =
          Anthropic::Organization::SpendLimitUserScope
          | Anthropic::Organization::SpendLimitSeatTierScope
          | Anthropic::Organization::SpendLimitRBACGroupScope
          | Anthropic::Organization::SpendLimitOrganizationServiceScope
          | Anthropic::Organization::SpendLimitOrganizationScope
          | Anthropic::Organization::SpendLimitWorkspaceScope
          | Anthropic::Organization::SpendLimitUsageTierScope

        module Source
          extend Anthropic::Internal::Type::Union

          type type_ =
            :user
            | :seat_tier
            | :rbac_group
            | :organization_service
            | :organization
            | :workspace
            | :usage_tier

          module Type
            extend Anthropic::Internal::Type::Enum

            USER: :user
            SEAT_TIER: :seat_tier
            RBAC_GROUP: :rbac_group
            ORGANIZATION_SERVICE: :organization_service
            ORGANIZATION: :organization
            WORKSPACE: :workspace
            USAGE_TIER: :usage_tier

            def self?.values: -> ::Array[Anthropic::Models::Organization::SpendSummary::Source::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Organization::SpendSummary::source]

          def self.new:
            (
              type: :user | "user",
              user_id: String
            ) -> Anthropic::Organization::SpendLimitUserScope
            | (
              type: :seat_tier | "seat_tier",
              seat_tier: String
            ) -> Anthropic::Organization::SpendLimitSeatTierScope
            | (
              type: :rbac_group | "rbac_group",
              rbac_group_id: String
            ) -> Anthropic::Organization::SpendLimitRBACGroupScope
            | (
              type: :organization_service | "organization_service",
              service: String
            ) -> Anthropic::Organization::SpendLimitOrganizationServiceScope
            | (
              type: :organization | "organization"
            ) -> Anthropic::Organization::SpendLimitOrganizationScope
            | (
              type: :workspace | "workspace",
              workspace_id: String
            ) -> Anthropic::Organization::SpendLimitWorkspaceScope
            | (
              type: :usage_tier | "usage_tier"
            ) -> Anthropic::Organization::SpendLimitUsageTierScope
            | (
              type: Anthropic::Models::Organization::SpendSummary::Source::type_
              | String,
              ?user_id: String,
              ?seat_tier: String,
              ?rbac_group_id: String,
              ?service: String,
              ?workspace_id: String
            ) -> Anthropic::Models::Organization::SpendSummary::source
