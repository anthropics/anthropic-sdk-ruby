module Anthropic
  module Models
    module Organization
      type workspace_role =
        :workspace_admin
        | :workspace_billing
        | :workspace_developer
        | :workspace_restricted_developer
        | :workspace_user

      module WorkspaceRole
        extend Anthropic::Internal::Type::Enum

        WORKSPACE_ADMIN: :workspace_admin
        WORKSPACE_BILLING: :workspace_billing
        WORKSPACE_DEVELOPER: :workspace_developer
        WORKSPACE_RESTRICTED_DEVELOPER: :workspace_restricted_developer
        WORKSPACE_USER: :workspace_user

        def self?.values: -> ::Array[Anthropic::Models::Organization::workspace_role]
      end
    end
  end
end
