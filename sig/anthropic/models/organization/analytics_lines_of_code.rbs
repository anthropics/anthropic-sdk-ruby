module Anthropic
  module Models
    module Organization
      type analytics_lines_of_code =
        { added_count: Integer, removed_count: Integer }

      class AnalyticsLinesOfCode < Anthropic::Internal::Type::BaseModel
        attr_accessor added_count: Integer

        attr_accessor removed_count: Integer

        def initialize: (added_count: Integer, removed_count: Integer) -> void

        def to_hash: -> { added_count: Integer, removed_count: Integer }
      end
    end
  end
end
