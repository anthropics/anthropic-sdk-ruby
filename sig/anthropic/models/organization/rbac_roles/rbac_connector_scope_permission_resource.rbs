module Anthropic
  module Models
    module Organization
      module RBACRoles
        type rbac_connector_scope_permission_resource =
          { connector_id: String, scope: String, type: :connector_scope }

        class RBACConnectorScopePermissionResource < Anthropic::Internal::Type::BaseModel
          attr_accessor connector_id: String

          attr_accessor scope: String

          attr_accessor type: :connector_scope

          def initialize: (
            connector_id: String,
            scope: String,
            ?type: :connector_scope
          ) -> void

          def to_hash: -> {
            connector_id: String,
            scope: String,
            type: :connector_scope
          }
        end
      end
    end
  end
end
