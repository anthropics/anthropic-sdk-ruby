module Anthropic
  module Models
    module Organization
      module Federation
        module Rules
          type workspace_list_params =
            { federation_rule_id: String, limit: Integer, page: String? }
            & Anthropic::Internal::Type::request_parameters

          class WorkspaceListParams < Anthropic::Internal::Type::BaseModel
            extend Anthropic::Internal::Type::RequestParameters::Converter
            include Anthropic::Internal::Type::RequestParameters

            attr_accessor federation_rule_id: String

            attr_reader limit: Integer?

            def limit=: (Integer) -> Integer

            attr_accessor page: String?

            def initialize: (
              federation_rule_id: String,
              ?limit: Integer,
              ?page: String?,
              ?request_options: Anthropic::request_opts
            ) -> void

            def to_hash: -> {
              federation_rule_id: String,
              limit: Integer,
              page: String?,
              request_options: Anthropic::RequestOptions
            }
          end
        end
      end
