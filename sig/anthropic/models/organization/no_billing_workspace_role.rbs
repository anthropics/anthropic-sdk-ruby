module Anthropic
  module Models
    module Organization
      type no_billing_workspace_role =
        :workspace_admin
        | :workspace_developer
        | :workspace_restricted_developer
        | :workspace_user

      module NoBillingWorkspaceRole
        extend Anthropic::Internal::Type::Enum

        WORKSPACE_ADMIN: :workspace_admin
        WORKSPACE_DEVELOPER: :workspace_developer
        WORKSPACE_RESTRICTED_DEVELOPER: :workspace_restricted_developer
        WORKSPACE_USER: :workspace_user

        def self?.values: -> ::Array[Anthropic::Models::Organization::no_billing_workspace_role]
      end
    end
  end
end
