module Anthropic
  module Models
    module Organization
      type spend_limit_period = :daily | :monthly | :weekly

      module SpendLimitPeriod
        extend Anthropic::Internal::Type::Enum

        DAILY: :daily
        MONTHLY: :monthly
        WEEKLY: :weekly

        def self?.values: -> ::Array[Anthropic::Models::Organization::spend_limit_period]
      end
    end
  end
end
