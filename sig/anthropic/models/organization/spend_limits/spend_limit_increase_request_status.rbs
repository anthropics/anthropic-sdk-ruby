module Anthropic
  module Models
    module Organization
      module SpendLimitIncreaseRequestStatus = SpendLimits::SpendLimitIncreaseRequestStatus

      module SpendLimits
        type spend_limit_increase_request_status =
          :approved | :denied | :pending

        module SpendLimitIncreaseRequestStatus
          extend Anthropic::Internal::Type::Enum

          APPROVED: :approved
          DENIED: :denied
          PENDING: :pending

          def self?.values: -> ::Array[Anthropic::Models::Organization::SpendLimits::spend_limit_increase_request_status]
        end
      end
    end
  end
end
