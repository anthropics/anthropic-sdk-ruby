module Anthropic
  module Models
    type billing_error_object = { message: String, type: :billing_error }

    class BillingErrorObject < Anthropic::Internal::Type::BaseModel
      attr_accessor message: String

      attr_accessor type: :billing_error

      def initialize: (message: String, ?type: :billing_error) -> void

      def to_hash: -> { message: String, type: :billing_error }
    end
  end
end
