module Anthropic
  module Models
    type diagnostics_param = { previous_message_id: String? }

    class DiagnosticsParam < Anthropic::Internal::Type::BaseModel
      attr_accessor previous_message_id: String?

      def initialize: (?previous_message_id: String?) -> void

      def to_hash: -> { previous_message_id: String? }
    end
  end
end
