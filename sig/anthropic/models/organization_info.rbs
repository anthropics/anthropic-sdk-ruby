module Anthropic
  module Models
    type organization_info = { id: String, name: String, type: :organization }

    class OrganizationInfo < Anthropic::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor name: String

      attr_accessor type: :organization

      def initialize: (id: String, name: String, ?type: :organization) -> void

      def to_hash: -> { id: String, name: String, type: :organization }
    end
  end
end
