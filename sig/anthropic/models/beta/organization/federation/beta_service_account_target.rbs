module Anthropic
  module Models
    module Beta
      module Organization
        module Federation
          type beta_service_account_target =
            {
              service_account_id: String,
              type: :service_account,
              service_account_name: String?
            }

          class BetaServiceAccountTarget < Anthropic::Internal::Type::BaseModel
            attr_accessor service_account_id: String

            attr_accessor type: :service_account

            attr_accessor service_account_name: String?

            def initialize: (
              service_account_id: String,
              ?service_account_name: String?,
              ?type: :service_account
            ) -> void

            def to_hash: -> {
              service_account_id: String,
              type: :service_account,
              service_account_name: String?
            }
          end
        end
      end
    end
  end
end
