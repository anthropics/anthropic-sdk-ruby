module Anthropic
  module Models
    module Beta
      module Organization
        module Federation
          type beta_federation_issuer =
            {
              id: String,
              archived_at: Time?,
              archived_by_actor_id: String?,
              check_jti: bool,
              created_at: Time,
              created_by_actor_id: String?,
              issuer_url: String,
              jwks: Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks,
              jwks_polling_disabled_at: Time?,
              max_jwt_lifetime_seconds: Integer,
              name: String,
              poll_status: Anthropic::Beta::Organization::Federation::BetaFederationIssuerPollStatus?,
              type: :federation_issuer,
              updated_at: Time,
              updated_by_actor_id: String?
            }

          class BetaFederationIssuer < Anthropic::Internal::Type::BaseModel
            attr_accessor id: String

            attr_accessor archived_at: Time?

            attr_accessor archived_by_actor_id: String?

            attr_accessor check_jti: bool

            attr_accessor created_at: Time

            attr_accessor created_by_actor_id: String?

            attr_accessor issuer_url: String

            attr_accessor jwks: Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks

            attr_accessor jwks_polling_disabled_at: Time?

            attr_accessor max_jwt_lifetime_seconds: Integer

            attr_accessor name: String

            attr_accessor poll_status: Anthropic::Beta::Organization::Federation::BetaFederationIssuerPollStatus?

            attr_accessor type: :federation_issuer

            attr_accessor updated_at: Time

            attr_accessor updated_by_actor_id: String?

            def initialize: (
              id: String,
              archived_at: Time?,
              archived_by_actor_id: String?,
              check_jti: bool,
              created_at: Time,
              created_by_actor_id: String?,
              issuer_url: String,
              jwks: Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks,
              jwks_polling_disabled_at: Time?,
              max_jwt_lifetime_seconds: Integer,
              name: String,
              poll_status: Anthropic::Beta::Organization::Federation::BetaFederationIssuerPollStatus?,
              updated_at: Time,
              updated_by_actor_id: String?,
              ?type: :federation_issuer
            ) -> void

            def to_hash: -> {
              id: String,
              archived_at: Time?,
              archived_by_actor_id: String?,
              check_jti: bool,
              created_at: Time,
              created_by_actor_id: String?,
              issuer_url: String,
              jwks: Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks,
              jwks_polling_disabled_at: Time?,
              max_jwt_lifetime_seconds: Integer,
              name: String,
              poll_status: Anthropic::Beta::Organization::Federation::BetaFederationIssuerPollStatus?,
              type: :federation_issuer,
              updated_at: Time,
              updated_by_actor_id: String?
            }

            type jwks =
              Anthropic::Beta::Organization::Federation::BetaJWKSDiscovery
              | Anthropic::Beta::Organization::Federation::BetaJWKSExplicitURL
              | Anthropic::Beta::Organization::Federation::BetaJWKSInline

            module JWKS
              extend Anthropic::Internal::Type::Union

              type type_ = :discovery | :explicit_url | :inline

              module Type
                extend Anthropic::Internal::Type::Enum

                DISCOVERY: :discovery
                EXPLICIT_URL: :explicit_url
                INLINE: :inline

                def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::JWKS::type_]
              end

              def self?.variants: -> ::Array[Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks]

              def self.new:
                (
                  type: :discovery | "discovery",
                  ?ca_cert_pem: String?,
                  ?discovery_base: String?
                ) -> Anthropic::Beta::Organization::Federation::BetaJWKSDiscovery
                | (
                  type: :explicit_url | "explicit_url",
                  url: String,
                  ?ca_cert_pem: String?
                ) -> Anthropic::Beta::Organization::Federation::BetaJWKSExplicitURL
                | (
                  type: :inline | "inline",
                  keys: ::Array[::Hash[Symbol, top]]
                ) -> Anthropic::Beta::Organization::Federation::BetaJWKSInline
                | (
                  type: Symbol | String,
                  ?ca_cert_pem: String?,
                  ?discovery_base: String?,
                  ?url: String,
                  ?keys: ::Array[::Hash[Symbol, top]]
                ) -> Anthropic::Models::Beta::Organization::Federation::BetaFederationIssuer::jwks
            end
          end
