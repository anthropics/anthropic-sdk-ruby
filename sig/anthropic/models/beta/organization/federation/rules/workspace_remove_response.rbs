module Anthropic
  module Models
    module Beta
      module Organization
        module Federation
          module Rules
            type workspace_remove_response =
              {
                federation_rule_id: String,
                type: :federation_rule_workspace_deleted,
                workspace_id: String
              }

            class WorkspaceRemoveResponse < Anthropic::Internal::Type::BaseModel
              attr_accessor federation_rule_id: String

              attr_accessor type: :federation_rule_workspace_deleted

              attr_accessor workspace_id: String

              def initialize: (
                federation_rule_id: String,
                workspace_id: String,
                ?type: :federation_rule_workspace_deleted
              ) -> void

              def to_hash: -> {
                federation_rule_id: String,
                type: :federation_rule_workspace_deleted,
                workspace_id: String
              }
            end
          end
        end
      end
    end
  end
end
