module Anthropic
  module Models
    module Beta
      module Organization
        type beta_aws_external_storage_config_param =
          {
            account_id: String,
            bucket_name: String,
            region: String,
            type: :aws
          }

        class BetaAWSExternalStorageConfigParam < Anthropic::Internal::Type::BaseModel
          attr_accessor account_id: String

          attr_accessor bucket_name: String

          attr_accessor region: String

          attr_accessor type: :aws

          def initialize: (
            account_id: String,
            bucket_name: String,
            region: String,
            ?type: :aws
          ) -> void

          def to_hash: -> {
            account_id: String,
            bucket_name: String,
            region: String,
            type: :aws
          }
        end
      end
    end
  end
end
