module Anthropic
  module Models
    module Beta
      module Organization
        type user_remove_params =
          { user_id: String } & Anthropic::Internal::Type::request_parameters

        class UserRemoveParams < Anthropic::Internal::Type::BaseModel
          extend Anthropic::Internal::Type::RequestParameters::Converter
          include Anthropic::Internal::Type::RequestParameters

          attr_accessor user_id: String

          def initialize: (
            user_id: String,
            ?request_options: Anthropic::request_opts
          ) -> void

          def to_hash: -> {
            user_id: String,
            request_options: Anthropic::RequestOptions
          }
        end
      end
    end
  end
end
