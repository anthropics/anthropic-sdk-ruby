module Anthropic
  module Models
    module Beta
      module Organization
        type beta_analytics_service_tier =
          :batch
          | :flex
          | :flex_discount
          | :priority
          | :priority_on_demand
          | :standard

        module BetaAnalyticsServiceTier
          extend Anthropic::Internal::Type::Enum

