          FLEX_DISCOUNT: :flex_discount
          PRIORITY: :priority
          PRIORITY_ON_DEMAND: :priority_on_demand
          STANDARD: :standard

          def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::beta_analytics_service_tier]
        end
