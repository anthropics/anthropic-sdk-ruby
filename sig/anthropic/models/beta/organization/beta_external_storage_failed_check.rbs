            message: String,
            role: Anthropic::Models::Beta::Organization::BetaExternalStorageFailedCheck::role?
          }

        class BetaExternalStorageFailedCheck < Anthropic::Internal::Type::BaseModel
          attr_accessor check: Anthropic::Models::Beta::Organization::BetaExternalStorageFailedCheck::check

