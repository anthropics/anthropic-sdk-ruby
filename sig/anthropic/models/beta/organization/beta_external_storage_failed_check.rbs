          def to_hash: -> {
            check: Anthropic::Models::Beta::Organization::BetaExternalStorageFailedCheck::check,
            message: String,
            role: Anthropic::Models::Beta::Organization::BetaExternalStorageFailedCheck::role?
          }

          type check =
            :already_registered
            | :assume_role
            | :bucket_empty
            | :bucket_not_confirmed
            | :bucket_policy
            | :bucket_settings
            | :default_encryption
            | :deletion_policy
            | :encryption
