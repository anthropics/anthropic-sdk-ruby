            | Anthropic::Beta::Organization::BetaAPIKeyServiceAccountActor

          module Principal
            extend Anthropic::Internal::Type::Union

            type type_ = :user_actor | :service_account_actor

            module Type
              extend Anthropic::Internal::Type::Enum

