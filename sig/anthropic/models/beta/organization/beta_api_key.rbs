          type status = :active | :archived | :expired | :inactive

          module Status
            extend Anthropic::Internal::Type::Enum

            ACTIVE: :active
            ARCHIVED: :archived
            EXPIRED: :expired
            INACTIVE: :inactive

            def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::BetaAPIKey::status]
