module Anthropic
  module Models
    module Beta
      module Organization
        type beta_organization_webhook_endpoint =
          {
            id: String,
            created_at: Time,
            description: String,
            disabled_reason: String,
            enabled_events: ::Array[Anthropic::Models::Beta::Organization::BetaOrganizationWebhookEndpoint::enabled_event],
            name: String,
            state: Anthropic::Models::Beta::Organization::beta_organization_webhook_endpoint_state,
            updated_at: Time,
            url: String
          }

        class BetaOrganizationWebhookEndpoint < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor created_at: Time

          attr_accessor description: String

          attr_accessor disabled_reason: String

          attr_accessor enabled_events: ::Array[Anthropic::Models::Beta::Organization::BetaOrganizationWebhookEndpoint::enabled_event]

          attr_accessor name: String

          attr_accessor state: Anthropic::Models::Beta::Organization::beta_organization_webhook_endpoint_state

          attr_accessor updated_at: Time

          attr_accessor url: String

          def initialize: (
            id: String,
            created_at: Time,
            description: String,
            disabled_reason: String,
            enabled_events: ::Array[Anthropic::Models::Beta::Organization::BetaOrganizationWebhookEndpoint::enabled_event],
            name: String,
            state: Anthropic::Models::Beta::Organization::beta_organization_webhook_endpoint_state,
            updated_at: Time,
            url: String
          ) -> void

          def to_hash: -> {
            id: String,
            created_at: Time,
            description: String,
            disabled_reason: String,
            enabled_events: ::Array[Anthropic::Models::Beta::Organization::BetaOrganizationWebhookEndpoint::enabled_event],
            name: String,
            state: Anthropic::Models::Beta::Organization::beta_organization_webhook_endpoint_state,
            updated_at: Time,
            url: String
          }

          type enabled_event =
            :"external_key.failed"
            | :"external_key.recovered"
            | :"external_storage.failed"
            | :"external_storage.recovered"
            | :"user_profile.enforcement_action_opened"
            | :"user_profile.enforcement_action_resolved"
            | :"user_profile.program_status_updated"

          module EnabledEvent
            extend Anthropic::Internal::Type::Enum

            EXTERNAL_KEY_FAILED: :"external_key.failed"
            EXTERNAL_KEY_RECOVERED: :"external_key.recovered"
            EXTERNAL_STORAGE_FAILED: :"external_storage.failed"
            EXTERNAL_STORAGE_RECOVERED: :"external_storage.recovered"
            USER_PROFILE_ENFORCEMENT_ACTION_OPENED: :"user_profile.enforcement_action_opened"
            USER_PROFILE_ENFORCEMENT_ACTION_RESOLVED: :"user_profile.enforcement_action_resolved"
            USER_PROFILE_PROGRAM_STATUS_UPDATED: :"user_profile.program_status_updated"

            def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::BetaOrganizationWebhookEndpoint::enabled_event]
          end
        end
      end
    end
