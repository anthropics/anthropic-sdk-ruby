              sessions: Anthropic::Beta::Organization::BetaAnalyticsSkillActivity::ChatCoworkUnifiedMetrics::Sessions
            }

            type chat = { distinct_conversation_skill_used_count: Integer? }

            class Chat < Anthropic::Internal::Type::BaseModel
              attr_accessor distinct_conversation_skill_used_count: Integer?

              def initialize: (
                distinct_conversation_skill_used_count: Integer?
              ) -> void

              def to_hash: -> {
                distinct_conversation_skill_used_count: Integer?
              }
            end

            type sessions = { distinct_session_skill_used_count: Integer? }

            class Sessions < Anthropic::Internal::Type::BaseModel
              attr_accessor distinct_session_skill_used_count: Integer?

              def initialize: (
                distinct_session_skill_used_count: Integer?
              ) -> void

              def to_hash: -> { distinct_session_skill_used_count: Integer? }
