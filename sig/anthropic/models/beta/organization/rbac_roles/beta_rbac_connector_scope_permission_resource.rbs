module Anthropic
  module Models
    module Beta
      module Organization
        module RBACRoles
          type beta_rbac_connector_scope_permission_resource =
            { connector_id: String, scope: String, type: :connector_scope }

          class BetaRBACConnectorScopePermissionResource < Anthropic::Internal::Type::BaseModel
