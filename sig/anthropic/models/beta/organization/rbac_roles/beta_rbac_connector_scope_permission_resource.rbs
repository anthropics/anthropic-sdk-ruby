            attr_accessor scope: String

            attr_accessor type: :connector_scope

            def initialize: (
              connector_id: String,
              scope: String,
              ?type: :connector_scope
            ) -> void

            def to_hash: -> {
              connector_id: String,
              scope: String,
              type: :connector_scope
            }
          end
        end
      end
    end
  end
end
