module Anthropic
  module Models
    module Beta
      module Organization
        type beta_storage_member =
          Anthropic::Beta::Organization::BetaInternalStorage
          | Anthropic::Beta::Organization::BetaExternalStorageMember

        module BetaStorageMember
          extend Anthropic::Internal::Type::Union

          type type_ = :internal | :external

          module Type
            extend Anthropic::Internal::Type::Enum

            INTERNAL: :internal
            EXTERNAL: :external

            def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::BetaStorageMember::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Beta::Organization::beta_storage_member]

          def self.new:
            (
              type: :internal | "internal"
            ) -> Anthropic::Beta::Organization::BetaInternalStorage
            | (
              type: :external | "external",
              external_storage_id: String
            ) -> Anthropic::Beta::Organization::BetaExternalStorageMember
            | (
              type: Anthropic::Models::Beta::Organization::BetaStorageMember::type_
              | String,
              ?external_storage_id: String
            ) -> Anthropic::Models::Beta::Organization::beta_storage_member
        end
      end
    end
  end
end
