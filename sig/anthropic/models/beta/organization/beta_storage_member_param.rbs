module Anthropic
  module Models
    module Beta
      module Organization
        type beta_storage_member_param =
          Anthropic::Beta::Organization::BetaInternalStorageParam
          | Anthropic::Beta::Organization::BetaExternalStorageMemberParam

        module BetaStorageMemberParam
          extend Anthropic::Internal::Type::Union

          type type_ = :internal | :external

          module Type
            extend Anthropic::Internal::Type::Enum

            INTERNAL: :internal
            EXTERNAL: :external

            def self?.values: -> ::Array[Anthropic::Models::Beta::Organization::BetaStorageMemberParam::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Beta::Organization::beta_storage_member_param]

          def self.new:
            (
              type: :internal | "internal"
            ) -> Anthropic::Beta::Organization::BetaInternalStorageParam
            | (
              type: :external | "external",
              external_storage_id: String
            ) -> Anthropic::Beta::Organization::BetaExternalStorageMemberParam
            | (
              type: Anthropic::Models::Beta::Organization::BetaStorageMemberParam::type_
              | String,
              ?external_storage_id: String
            ) -> Anthropic::Models::Beta::Organization::beta_storage_member_param
        end
      end
    end
  end
end
