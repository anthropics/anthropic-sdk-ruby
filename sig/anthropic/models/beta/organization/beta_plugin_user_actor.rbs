module Anthropic
  module Models
    module Beta
      module Organization
        type beta_plugin_user_actor =
          { email_address: String?, type: :user_actor, user_id: String }

        class BetaPluginUserActor < Anthropic::Internal::Type::BaseModel
          attr_accessor email_address: String?

          attr_accessor type: :user_actor

          attr_accessor user_id: String

          def initialize: (
            email_address: String?,
            user_id: String,
            ?type: :user_actor
          ) -> void

          def to_hash: -> {
            email_address: String?,
            type: :user_actor,
            user_id: String
          }
        end
      end
    end
  end
end
