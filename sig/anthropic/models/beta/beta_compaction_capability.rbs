module Anthropic
  module Models
    class BetaCompactionCapability = Beta::BetaCompactionCapability

    module Beta
      type beta_compaction_capability =
        { summarize: Anthropic::Beta::BetaCapabilitySupport, supported: bool }

      class BetaCompactionCapability < Anthropic::Internal::Type::BaseModel
        attr_accessor summarize: Anthropic::Beta::BetaCapabilitySupport

        attr_accessor supported: bool

        def initialize: (
          summarize: Anthropic::Beta::BetaCapabilitySupport,
          supported: bool
        ) -> void

        def to_hash: -> {
          summarize: Anthropic::Beta::BetaCapabilitySupport,
          supported: bool
        }
      end
    end
  end
end
