module Anthropic
  module Models
    module BetaManagedAgentsTriggerContext = Beta::BetaManagedAgentsTriggerContext

    module Beta
      type beta_managed_agents_trigger_context =
        Anthropic::Beta::BetaManagedAgentsScheduleTriggerContext
        | Anthropic::Beta::BetaManagedAgentsManualTriggerContext

      module BetaManagedAgentsTriggerContext
        extend Anthropic::Internal::Type::Union

        type type_ = :schedule | :manual

        module Type
          extend Anthropic::Internal::Type::Enum

          SCHEDULE: :schedule
          MANUAL: :manual

          def self?.values: -> ::Array[Anthropic::Models::Beta::BetaManagedAgentsTriggerContext::type_]
        end

        def self?.variants: -> ::Array[Anthropic::Models::Beta::beta_managed_agents_trigger_context]

        def self.new:
          (
            type: :schedule | "schedule",
            scheduled_at: Time
          ) -> Anthropic::Beta::BetaManagedAgentsScheduleTriggerContext
          | (
            type: :manual | "manual"
          ) -> Anthropic::Beta::BetaManagedAgentsManualTriggerContext
          | (
            type: Symbol | String,
            ?scheduled_at: Time
          ) -> Anthropic::Models::Beta::beta_managed_agents_trigger_context
      end
    end
  end
end
