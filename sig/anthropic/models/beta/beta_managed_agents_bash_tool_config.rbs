        {
          enabled: bool,
          name: :bash,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy,
          type: :bash
        }

      class BetaManagedAgentsBashToolConfig < Anthropic::Internal::Type::BaseModel
        attr_accessor enabled: bool

        attr_accessor name: :bash

        attr_accessor permission_policy: Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy

        attr_accessor type: :bash

        def initialize: (
          enabled: bool,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy,
          ?name: :bash,
          ?type: :bash
        ) -> void

        def to_hash: -> {
          enabled: bool,
          name: :bash,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy,
          type: :bash
        }

        type permission_policy =
          Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
          | Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy

        module PermissionPolicy
          extend Anthropic::Internal::Type::Union

          type type_ = :always_allow | :always_ask

          module Type
            extend Anthropic::Internal::Type::Enum

            ALWAYS_ALLOW: :always_allow
            ALWAYS_ASK: :always_ask

            def self?.values: -> ::Array[Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::PermissionPolicy::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy]

          def self.new:
            (
              type: :always_allow | "always_allow"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
            | (
              type: :always_ask | "always_ask"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy
            | (
              type: Symbol | String
            ) -> Anthropic::Models::Beta::BetaManagedAgentsBashToolConfig::permission_policy
        end
