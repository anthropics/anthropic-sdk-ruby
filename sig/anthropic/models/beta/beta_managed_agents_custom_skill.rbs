        attr_accessor type: :custom

        attr_accessor version: String

        def initialize: (
          skill_id: String,
          version: String,
          ?type: :custom
        ) -> void

        def to_hash: -> { skill_id: String, type: :custom, version: String }
      end
    end
  end
end
