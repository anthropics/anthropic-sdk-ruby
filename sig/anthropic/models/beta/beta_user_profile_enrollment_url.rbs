module Anthropic
  module Models
    class BetaUserProfileEnrollmentURL = Beta::BetaUserProfileEnrollmentURL

    module Beta
      type beta_user_profile_enrollment_url =
        { expires_at: Time, type: :enrollment_url, url: String }

      class BetaUserProfileEnrollmentURL < Anthropic::Internal::Type::BaseModel
        attr_accessor expires_at: Time

        attr_accessor type: :enrollment_url

        attr_accessor url: String

        def initialize: (
          expires_at: Time,
          url: String,
          ?type: :enrollment_url
        ) -> void

        def to_hash: -> { expires_at: Time, type: :enrollment_url, url: String }
      end
    end
  end
end
