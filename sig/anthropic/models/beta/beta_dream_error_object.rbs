module Anthropic
  module Models
    class BetaDreamErrorObject = Beta::BetaDreamErrorObject

    module Beta
      type beta_dream_error_object = { message: String, type: String }

      class BetaDreamErrorObject < Anthropic::Internal::Type::BaseModel
        attr_accessor message: String

        attr_accessor type: String

        def initialize: (message: String, type: String) -> void

        def to_hash: -> { message: String, type: String }
      end
    end
  end
end
