module Anthropic
  module Models
    class BetaManagedAgentsEditToolConfig = Beta::BetaManagedAgentsEditToolConfig

    module Beta
      type beta_managed_agents_edit_tool_config =
        {
          enabled: bool,
          name: :edit,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy,
          type: :edit
        }

      class BetaManagedAgentsEditToolConfig < Anthropic::Internal::Type::BaseModel
        attr_accessor enabled: bool

        attr_accessor name: :edit

        attr_accessor permission_policy: Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy

        attr_accessor type: :edit

        def initialize: (
          enabled: bool,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy,
          ?name: :edit,
          ?type: :edit
        ) -> void

        def to_hash: -> {
          enabled: bool,
          name: :edit,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy,
          type: :edit
        }

        type permission_policy =
          Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
          | Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy

        module PermissionPolicy
          extend Anthropic::Internal::Type::Union

          def self?.variants: -> ::Array[Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy]

          def self.new:
            (
              type: :always_allow | "always_allow"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
            | (
              type: :always_ask | "always_ask"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy
            | (
              type: Symbol | String
            ) -> Anthropic::Models::Beta::BetaManagedAgentsEditToolConfig::permission_policy
        end
      end
    end
  end
end
