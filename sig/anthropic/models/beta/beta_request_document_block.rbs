module Anthropic
  module Models
    class BetaRequestDocumentBlock = Beta::BetaRequestDocumentBlock

    module Beta
      type beta_request_document_block =
        {
          source: Anthropic::Models::Beta::BetaRequestDocumentBlock::source,
          type: :document,
          cache_control: Anthropic::Beta::BetaCacheControlEphemeral?,
          citations: Anthropic::Beta::BetaCitationsConfigParam?,
          context: String?,
          title: String?
        }

      class BetaRequestDocumentBlock < Anthropic::Internal::Type::BaseModel
        attr_accessor source: Anthropic::Models::Beta::BetaRequestDocumentBlock::source

        attr_accessor type: :document

        attr_accessor cache_control: Anthropic::Beta::BetaCacheControlEphemeral?

        attr_accessor citations: Anthropic::Beta::BetaCitationsConfigParam?

        attr_accessor context: String?

        attr_accessor title: String?

        def initialize: (
          source: Anthropic::Models::Beta::BetaRequestDocumentBlock::source,
          ?cache_control: Anthropic::Beta::BetaCacheControlEphemeral?,
          ?citations: Anthropic::Beta::BetaCitationsConfigParam?,
          ?context: String?,
          ?title: String?,
          ?type: :document
        ) -> void

        def to_hash: -> {
          source: Anthropic::Models::Beta::BetaRequestDocumentBlock::source,
          type: :document,
          cache_control: Anthropic::Beta::BetaCacheControlEphemeral?,
          citations: Anthropic::Beta::BetaCitationsConfigParam?,
          context: String?,
          title: String?
        }

        type source =
          Anthropic::Beta::BetaBase64PDFSource
          | Anthropic::Beta::BetaPlainTextSource
          | Anthropic::Beta::BetaContentBlockSource
          | Anthropic::Beta::BetaURLPDFSource
          | Anthropic::Beta::BetaFileDocumentSource

        module Source
          extend Anthropic::Internal::Type::Union

          type type_ = :base64 | :text | :content | :url | :file

          module Type
            extend Anthropic::Internal::Type::Enum

            BASE64: :base64
            TEXT: :text
            CONTENT: :content
            URL: :url
            FILE: :file

            def self?.values: -> ::Array[Anthropic::Models::Beta::BetaRequestDocumentBlock::Source::type_]
          end

          def self?.variants: -> ::Array[Anthropic::Models::Beta::BetaRequestDocumentBlock::source]

          def self.new:
            (
              type: :base64 | "base64",
              data: String,
              ?media_type: :"application/pdf"
            ) -> Anthropic::Beta::BetaBase64PDFSource
            | (
              type: :text | "text",
              data: String,
              ?media_type: :"text/plain"
            ) -> Anthropic::Beta::BetaPlainTextSource
            | (
              type: :content | "content",
              content: Anthropic::Models::Beta::BetaContentBlockSource::content
            ) -> Anthropic::Beta::BetaContentBlockSource
            | (
              type: :url | "url",
              url: String
            ) -> Anthropic::Beta::BetaURLPDFSource
            | (
              type: :file | "file",
              file_id: String
            ) -> Anthropic::Beta::BetaFileDocumentSource
            | (
              type: Symbol | String,
              ?data: String,
              ?media_type: :"application/pdf" | :"text/plain",
              ?content: Anthropic::Models::Beta::BetaContentBlockSource::content,
              ?url: String,
              ?file_id: String
            ) -> Anthropic::Models::Beta::BetaRequestDocumentBlock::source
        end
