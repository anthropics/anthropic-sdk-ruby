module Anthropic
  module Models
    module BetaManagedAgentsSessionResourceConfig = Beta::BetaManagedAgentsSessionResourceConfig

    module Beta
      type beta_managed_agents_session_resource_config =
        Anthropic::Beta::BetaManagedAgentsGitHubRepositoryResourceConfig
        | Anthropic::Beta::BetaManagedAgentsFileResourceConfig
        | Anthropic::Beta::BetaManagedAgentsMemoryStoreResourceConfig

      module BetaManagedAgentsSessionResourceConfig
        extend Anthropic::Internal::Type::Union

        def self?.variants: -> ::Array[Anthropic::Models::Beta::beta_managed_agents_session_resource_config]

        def self.new:
          (
            type: :github_repository | "github_repository",
            url: String,
            ?checkout: Anthropic::Models::Beta::BetaManagedAgentsGitHubRepositoryResourceConfig::checkout?,
            ?mount_path: String?
          ) -> Anthropic::Beta::BetaManagedAgentsGitHubRepositoryResourceConfig
          | (
            type: :file | "file",
            file_id: String,
            ?mount_path: String?
          ) -> Anthropic::Beta::BetaManagedAgentsFileResourceConfig
          | (
            type: :memory_store | "memory_store",
            memory_store_id: String,
            ?access: Anthropic::Models::Beta::BetaManagedAgentsMemoryStoreResourceConfig::access?,
            ?instructions: String?
          ) -> Anthropic::Beta::BetaManagedAgentsMemoryStoreResourceConfig
          | (
            type: Symbol | String,
            ?url: String,
            ?checkout: Anthropic::Models::Beta::BetaManagedAgentsGitHubRepositoryResourceConfig::checkout?,
            ?mount_path: String?,
            ?file_id: String,
            ?memory_store_id: String,
            ?access: Anthropic::Models::Beta::BetaManagedAgentsMemoryStoreResourceConfig::access?,
            ?instructions: String?
          ) -> Anthropic::Models::Beta::beta_managed_agents_session_resource_config
      end
    end
  end
end
