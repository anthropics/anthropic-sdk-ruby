              type: :always_allow | "always_allow"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
            | (
              type: :always_ask | "always_ask"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy
            | (
              type: Symbol | String
            ) -> Anthropic::Models::Beta::BetaManagedAgentsMCPToolConfig::permission_policy
        end
