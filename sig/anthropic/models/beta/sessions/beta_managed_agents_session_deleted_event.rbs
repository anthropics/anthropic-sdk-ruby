module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_session_deleted_event =
          { id: String, processed_at: Time, type: :"session.deleted" }

        class BetaManagedAgentsSessionDeletedEvent < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor processed_at: Time

          attr_accessor type: :"session.deleted"

          def initialize: (
            id: String,
            processed_at: Time,
            ?type: :"session.deleted"
          ) -> void

          def to_hash: -> {
            id: String,
            processed_at: Time,
            type: :"session.deleted"
          }
        end
      end
    end
  end
end
