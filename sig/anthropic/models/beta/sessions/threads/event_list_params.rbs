module Anthropic
  module Models
    module Beta
      module Sessions
        module Threads
          type event_list_params =
            {
              session_id: String,
              thread_id: String,
              limit: Integer,
              page: String,
              betas: ::Array[Anthropic::Models::anthropic_beta],
              workspace_id: String
            }
            & Anthropic::Internal::Type::request_parameters

          class EventListParams < Anthropic::Internal::Type::BaseModel
            extend Anthropic::Internal::Type::RequestParameters::Converter
            include Anthropic::Internal::Type::RequestParameters

            attr_accessor session_id: String

            attr_accessor thread_id: String

            attr_reader limit: Integer?

            def limit=: (Integer) -> Integer

            attr_reader page: String?

            def page=: (String) -> String

            attr_reader betas: ::Array[Anthropic::Models::anthropic_beta]?

            def betas=: (
              ::Array[Anthropic::Models::anthropic_beta]
            ) -> ::Array[Anthropic::Models::anthropic_beta]

            attr_reader workspace_id: String?

            def workspace_id=: (String) -> String

            def initialize: (
              session_id: String,
              thread_id: String,
              ?limit: Integer,
              ?page: String,
              ?betas: ::Array[Anthropic::Models::anthropic_beta],
              ?workspace_id: String,
              ?request_options: Anthropic::request_opts
            ) -> void

            def to_hash: -> {
              session_id: String,
              thread_id: String,
              limit: Integer,
              page: String,
              betas: ::Array[Anthropic::Models::anthropic_beta],
              workspace_id: String,
              request_options: Anthropic::RequestOptions
            }
          end
        end
      end
    end
  end
end
