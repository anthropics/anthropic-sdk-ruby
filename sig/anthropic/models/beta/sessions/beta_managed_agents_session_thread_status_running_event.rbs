module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_session_thread_status_running_event =
          {
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            type: :"session.thread_status_running"
          }

        class BetaManagedAgentsSessionThreadStatusRunningEvent < Anthropic::Internal::Type::BaseModel
