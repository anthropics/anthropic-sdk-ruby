          attr_accessor agent_name: String

          attr_accessor processed_at: Time

          attr_accessor session_thread_id: String

          attr_accessor type: :"session.thread_status_running"

          def initialize: (
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            ?type: :"session.thread_status_running"
          ) -> void

          def to_hash: -> {
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            type: :"session.thread_status_running"
          }
        end
