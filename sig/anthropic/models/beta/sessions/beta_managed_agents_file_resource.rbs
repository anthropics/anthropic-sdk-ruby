module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_file_resource =
          {
            id: String,
            created_at: Time,
            file_id: String,
            mount_path: String,
            type: :file,
            updated_at: Time
          }

        class BetaManagedAgentsFileResource < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor created_at: Time

          attr_accessor file_id: String

          attr_accessor mount_path: String

          attr_accessor type: :file

          attr_accessor updated_at: Time

          def initialize: (
            id: String,
            created_at: Time,
            file_id: String,
            mount_path: String,
            updated_at: Time,
            ?type: :file
          ) -> void

          def to_hash: -> {
            id: String,
            created_at: Time,
            file_id: String,
            mount_path: String,
            type: :file,
            updated_at: Time
          }
        end
      end
    end
  end
end
