module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_user_interrupt_event =
          {
            id: String,
            type: :"user.interrupt",
            processed_at: Time?,
            session_thread_id: String?
          }

        class BetaManagedAgentsUserInterruptEvent < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor type: :"user.interrupt"

          attr_accessor processed_at: Time?

          attr_accessor session_thread_id: String?

          def initialize: (
            id: String,
            ?processed_at: Time?,
            ?session_thread_id: String?,
            ?type: :"user.interrupt"
          ) -> void

          def to_hash: -> {
            id: String,
            type: :"user.interrupt",
            processed_at: Time?,
            session_thread_id: String?
          }
        end
      end
    end
  end
end
