module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_agent_thinking_event =
          { id: String, processed_at: Time, type: :"agent.thinking" }

        class BetaManagedAgentsAgentThinkingEvent < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor processed_at: Time

          attr_accessor type: :"agent.thinking"

          def initialize: (
            id: String,
            processed_at: Time,
            ?type: :"agent.thinking"
          ) -> void

          def to_hash: -> {
            id: String,
            processed_at: Time,
            type: :"agent.thinking"
          }
        end
      end
    end
  end
end
