module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_user_interrupt_event_params =
          { type: :"user.interrupt", session_thread_id: String? }

        class BetaManagedAgentsUserInterruptEventParams < Anthropic::Internal::Type::BaseModel
          attr_accessor type: :"user.interrupt"

          attr_accessor session_thread_id: String?

          def initialize: (
            ?session_thread_id: String?,
            ?type: :"user.interrupt"
          ) -> void

          def to_hash: -> {
            type: :"user.interrupt",
            session_thread_id: String?
          }
        end
      end
    end
  end
end
