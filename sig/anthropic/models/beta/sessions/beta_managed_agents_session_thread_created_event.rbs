module Anthropic
  module Models
    module Beta
      module Sessions
        type beta_managed_agents_session_thread_created_event =
          {
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            type: :"session.thread_created",
            workflow_run_id: String?
          }

        class BetaManagedAgentsSessionThreadCreatedEvent < Anthropic::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor agent_name: String

          attr_accessor processed_at: Time

          attr_accessor session_thread_id: String

          attr_accessor type: :"session.thread_created"

          attr_accessor workflow_run_id: String?

          def initialize: (
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            workflow_run_id: String?,
            ?type: :"session.thread_created"
          ) -> void

          def to_hash: -> {
            id: String,
            agent_name: String,
            processed_at: Time,
            session_thread_id: String,
            type: :"session.thread_created",
            workflow_run_id: String?
          }
        end
      end
    end
  end
end
