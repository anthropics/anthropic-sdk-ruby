          content: Anthropic::Models::Beta::BetaSystemMessageParam::content,
          output_config: Anthropic::Beta::BetaSystemMessageOutputConfig?
        }

      class BetaSystemMessageParam < Anthropic::Internal::Type::BaseModel
        attr_accessor role: :system

        attr_accessor clear_at: Anthropic::Models::Beta::BetaSystemMessageParam::clear_at?

        attr_reader content: Anthropic::Models::Beta::BetaSystemMessageParam::content?

        def content=: (
          Anthropic::Models::Beta::BetaSystemMessageParam::content
        ) -> Anthropic::Models::Beta::BetaSystemMessageParam::content

        attr_accessor output_config: Anthropic::Beta::BetaSystemMessageOutputConfig?

        def initialize: (
