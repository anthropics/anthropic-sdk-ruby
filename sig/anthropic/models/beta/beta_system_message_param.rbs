          content: Anthropic::Models::Beta::BetaSystemMessageParam::content,
          output_config: Anthropic::Beta::BetaSystemMessageOutputConfig?
        }

        type clear_at = :next_user_message | :never

        module ClearAt
          extend Anthropic::Internal::Type::Enum

          NEXT_USER_MESSAGE: :next_user_message
          NEVER: :never

          def self?.values: -> ::Array[Anthropic::Models::Beta::BetaSystemMessageParam::clear_at]
        end

        type content =
