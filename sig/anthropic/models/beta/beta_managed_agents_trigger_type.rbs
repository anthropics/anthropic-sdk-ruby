module Anthropic
  module Models
    module BetaManagedAgentsTriggerType = Beta::BetaManagedAgentsTriggerType

    module Beta
      type beta_managed_agents_trigger_type = :schedule | :manual

      module BetaManagedAgentsTriggerType
        extend Anthropic::Internal::Type::Enum

        # The run was fired by the deployment's cron schedule.
        SCHEDULE: :schedule

        # The run was started manually by creating a session directly against the deployment.
        MANUAL: :manual

        def self?.values: -> ::Array[Anthropic::Models::Beta::beta_managed_agents_trigger_type]
      end
    end
  end
end
