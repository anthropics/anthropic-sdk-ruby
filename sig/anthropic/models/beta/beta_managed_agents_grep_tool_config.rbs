module Anthropic
  module Models
    class BetaManagedAgentsGrepToolConfig = Beta::BetaManagedAgentsGrepToolConfig

    module Beta
      type beta_managed_agents_grep_tool_config =
        {
          enabled: bool,
          name: :grep,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy,
          type: :grep
        }

      class BetaManagedAgentsGrepToolConfig < Anthropic::Internal::Type::BaseModel
        attr_accessor enabled: bool

        attr_accessor name: :grep

        attr_accessor permission_policy: Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy

        attr_accessor type: :grep

        def initialize: (
          enabled: bool,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy,
          ?name: :grep,
          ?type: :grep
        ) -> void

        def to_hash: -> {
          enabled: bool,
          name: :grep,
          permission_policy: Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy,
          type: :grep
        }

        type permission_policy =
          Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
          | Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy

        module PermissionPolicy
          extend Anthropic::Internal::Type::Union

          def self?.variants: -> ::Array[Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy]

          def self.new:
            (
              type: :always_allow | "always_allow"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAllowPolicy
            | (
              type: :always_ask | "always_ask"
            ) -> Anthropic::Beta::BetaManagedAgentsAlwaysAskPolicy
            | (
              type: Symbol | String
            ) -> Anthropic::Models::Beta::BetaManagedAgentsGrepToolConfig::permission_policy
        end
      end
    end
  end
end
