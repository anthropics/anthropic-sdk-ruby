module Anthropic
  module Models
    class BetaManagedAgentsBudgetLimit = Beta::BetaManagedAgentsBudgetLimit

    module Beta
      type beta_managed_agents_budget_limit =
        { max_list_cost: Anthropic::BetaMonetaryAmount, type: :limit }

      class BetaManagedAgentsBudgetLimit < Anthropic::Internal::Type::BaseModel
        attr_accessor max_list_cost: Anthropic::BetaMonetaryAmount

        attr_accessor type: :limit

        def initialize: (
          max_list_cost: Anthropic::BetaMonetaryAmount,
          ?type: :limit
        ) -> void

        def to_hash: -> {
          max_list_cost: Anthropic::BetaMonetaryAmount,
          type: :limit
        }
      end
    end
  end
end
