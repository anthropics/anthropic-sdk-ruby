module Anthropic
  module Models
    class BetaFallbackParam = Beta::BetaFallbackParam

    module Beta
      type beta_fallback_param =
        {
          model: Anthropic::Models::model,
          max_tokens: Integer?,
          output_config: Anthropic::Beta::BetaOutputConfig?,
          speed: Anthropic::Models::Beta::BetaFallbackParam::speed?,
          thinking: Anthropic::Models::Beta::BetaFallbackParam::thinking?
        }

      class BetaFallbackParam < Anthropic::Internal::Type::BaseModel
        attr_accessor model: Anthropic::Models::model

        attr_accessor max_tokens: Integer?

        attr_accessor output_config: Anthropic::Beta::BetaOutputConfig?

        attr_accessor speed: Anthropic::Models::Beta::BetaFallbackParam::speed?

        attr_accessor thinking: Anthropic::Models::Beta::BetaFallbackParam::thinking?

        def initialize: (
          model: Anthropic::Models::model,
          ?max_tokens: Integer?,
          ?output_config: Anthropic::Beta::BetaOutputConfig?,
          ?speed: Anthropic::Models::Beta::BetaFallbackParam::speed?,
          ?thinking: Anthropic::Models::Beta::BetaFallbackParam::thinking?
        ) -> void

        def to_hash: -> {
          model: Anthropic::Models::model,
          max_tokens: Integer?,
          output_config: Anthropic::Beta::BetaOutputConfig?,
          speed: Anthropic::Models::Beta::BetaFallbackParam::speed?,
          thinking: Anthropic::Models::Beta::BetaFallbackParam::thinking?
        }

        type speed = :standard | :fast

        module Speed
          extend Anthropic::Internal::Type::Enum

          STANDARD: :standard
          FAST: :fast

          def self?.values: -> ::Array[Anthropic::Models::Beta::BetaFallbackParam::speed]
        end

        type thinking =
          Anthropic::Beta::BetaThinkingConfigEnabled
          | Anthropic::Beta::BetaThinkingConfigDisabled
          | Anthropic::Beta::BetaFallbackParam::Thinking::BetweenTools
          | Anthropic::Beta::BetaThinkingConfigAdaptive

        module Thinking
          extend Anthropic::Internal::Type::Union

          type type_ = :enabled | :disabled | :between_tools | :adaptive

          module Type
            extend Anthropic::Internal::Type::Enum

            ENABLED: :enabled
            DISABLED: :disabled
            BETWEEN_TOOLS: :between_tools
            ADAPTIVE: :adaptive

            def self?.values: -> ::Array[Anthropic::Models::Beta::BetaFallbackParam::Thinking::type_]
          end

          type between_tools = { type: :between_tools }

          class BetweenTools < Anthropic::Internal::Type::BaseModel
            attr_accessor type: :between_tools

            def initialize: (?type: :between_tools) -> void

            def to_hash: -> { type: :between_tools }
          end

          def self?.variants: -> ::Array[Anthropic::Models::Beta::BetaFallbackParam::thinking]

          def self.new:
            (
              type: :enabled | "enabled",
              budget_tokens: Integer,
              ?block_binding: Anthropic::Beta::BetaThinkingBlockBinding?,
              ?display_: Anthropic::Models::Beta::BetaThinkingConfigEnabled::display_?
            ) -> Anthropic::Beta::BetaThinkingConfigEnabled
            | (
              type: :disabled | "disabled"
            ) -> Anthropic::Beta::BetaThinkingConfigDisabled
            | (
              type: :between_tools | "between_tools"
            ) -> Anthropic::Beta::BetaFallbackParam::Thinking::BetweenTools
            | (
              type: :adaptive | "adaptive",
              ?block_binding: Anthropic::Beta::BetaThinkingBlockBinding?,
              ?display_: Anthropic::Models::Beta::BetaThinkingConfigAdaptive::display_?
            ) -> Anthropic::Beta::BetaThinkingConfigAdaptive
            | (
              type: Anthropic::Models::Beta::BetaFallbackParam::Thinking::type_
              | String,
              ?budget_tokens: Integer,
              ?block_binding: Anthropic::Beta::BetaThinkingBlockBinding?,
              ?display_: Anthropic::Models::Beta::BetaThinkingConfigEnabled::display_?
              | Anthropic::Models::Beta::BetaThinkingConfigAdaptive::display_?
            ) -> Anthropic::Models::Beta::BetaFallbackParam::thinking
        end
      end
    end
  end
end
