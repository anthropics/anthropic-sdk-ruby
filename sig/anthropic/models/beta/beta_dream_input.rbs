module Anthropic
  module Models
    module BetaDreamInput = Beta::BetaDreamInput

    module Beta
      type beta_dream_input =
        Anthropic::Beta::BetaDreamMemoryStoreInput
        | Anthropic::Beta::BetaDreamSessionsInput

      module BetaDreamInput
        extend Anthropic::Internal::Type::Union

        def self?.variants: -> ::Array[Anthropic::Models::Beta::beta_dream_input]

        def self.new:
          (
            type: :memory_store | "memory_store",
            memory_store_id: String
          ) -> Anthropic::Beta::BetaDreamMemoryStoreInput
          | (
            type: :sessions | "sessions",
            session_ids: ::Array[String]
          ) -> Anthropic::Beta::BetaDreamSessionsInput
          | (
            type: Symbol | String,
            ?memory_store_id: String,
            ?session_ids: ::Array[String]
          ) -> Anthropic::Models::Beta::beta_dream_input
      end
    end
  end
end
