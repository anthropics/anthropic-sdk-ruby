          ) -> Anthropic::Beta::BetaRawContentBlockStopEvent
          | (
            type: Symbol | String,
            ?message: Anthropic::Beta::BetaMessage,
            ?context_management: Anthropic::Beta::BetaContextManagementResponse?,
            ?delta: Anthropic::Beta::BetaRawMessageDeltaEvent::Delta
