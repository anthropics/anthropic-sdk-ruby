        | Anthropic::Beta::BetaRawContentBlockDeltaEvent
        | Anthropic::Beta::BetaRawContentBlockStopEvent

      module BetaRawMessageStreamEvent
        extend Anthropic::Internal::Type::Union

        type type_ =
