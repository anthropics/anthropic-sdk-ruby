module Anthropic
  module Models
    class BetaManagedAgentsSessionUsageEvent = Beta::BetaManagedAgentsSessionUsageEvent

    module Beta
      type beta_managed_agents_session_usage_event =
        {
          id: String,
          processed_at: Time,
          type: :"session.usage",
          usage: Anthropic::Beta::Sessions::BetaManagedAgentsSessionUsageSnapshot,
          budget: Anthropic::Beta::BetaManagedAgentsBudgetLimit?
        }

      class BetaManagedAgentsSessionUsageEvent < Anthropic::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor processed_at: Time

        attr_accessor type: :"session.usage"

        attr_accessor usage: Anthropic::Beta::Sessions::BetaManagedAgentsSessionUsageSnapshot

        attr_accessor budget: Anthropic::Beta::BetaManagedAgentsBudgetLimit?

        def initialize: (
          id: String,
          processed_at: Time,
          usage: Anthropic::Beta::Sessions::BetaManagedAgentsSessionUsageSnapshot,
          ?budget: Anthropic::Beta::BetaManagedAgentsBudgetLimit?,
          ?type: :"session.usage"
        ) -> void

        def to_hash: -> {
          id: String,
          processed_at: Time,
          type: :"session.usage",
          usage: Anthropic::Beta::Sessions::BetaManagedAgentsSessionUsageSnapshot,
          budget: Anthropic::Beta::BetaManagedAgentsBudgetLimit?
        }
      end
    end
  end
end
