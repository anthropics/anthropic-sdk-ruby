module Anthropic
  module Models
    module BetaMessageParam = Beta::BetaMessageParam

    module Beta
      type beta_message_param =
        Anthropic::Beta::BetaUserMessageParam
        | Anthropic::Beta::BetaAssistantMessageParam
        | Anthropic::Beta::BetaSystemMessageParam

      module BetaMessageParam
        extend Anthropic::Internal::Type::Union

        type role = :user | :assistant | :system

        module Role
          extend Anthropic::Internal::Type::Enum

          USER: :user
          ASSISTANT: :assistant
          SYSTEM: :system

          def self?.values: -> ::Array[Anthropic::Models::Beta::BetaMessageParam::role]
        end

        def self?.variants: -> ::Array[Anthropic::Models::Beta::beta_message_param]

        def self.new:
          (
            role: :user | "user",
            content: Anthropic::Models::Beta::beta_message_content_param
          ) -> Anthropic::Beta::BetaUserMessageParam
          | (
            role: :assistant | "assistant",
            content: Anthropic::Models::Beta::beta_message_content_param
          ) -> Anthropic::Beta::BetaAssistantMessageParam
          | (
            role: :system | "system",
            ?clear_at: Anthropic::Models::Beta::BetaSystemMessageParam::clear_at?,
            ?content: Anthropic::Models::Beta::BetaSystemMessageParam::content,
            ?output_config: Anthropic::Beta::BetaSystemMessageOutputConfig?
          ) -> Anthropic::Beta::BetaSystemMessageParam
          | (
            role: Anthropic::Models::Beta::BetaMessageParam::role | String,
            ?content: Anthropic::Models::Beta::beta_message_content_param
            | Anthropic::Models::Beta::BetaSystemMessageParam::content,
            ?clear_at: Anthropic::Models::Beta::BetaSystemMessageParam::clear_at?,
            ?output_config: Anthropic::Beta::BetaSystemMessageOutputConfig?
          ) -> Anthropic::Models::Beta::beta_message_param
      end
    end
  end
end
