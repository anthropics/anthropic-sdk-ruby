          {
            type: :memory_path_conflict_error,
            conflicting_memory_id: String,
            conflicting_path: String,
            message: String
          }

        class BetaManagedAgentsMemoryPathConflictError < Anthropic::Internal::Type::BaseModel
          attr_accessor type: :memory_path_conflict_error

          attr_reader conflicting_memory_id: String?

          def conflicting_memory_id=: (String) -> String

          attr_reader conflicting_path: String?

          def conflicting_path=: (String) -> String

          attr_reader message: String?

          def message=: (String) -> String

          def initialize: (
            ?conflicting_memory_id: String,
            ?conflicting_path: String,
            ?message: String,
            ?type: :memory_path_conflict_error
          ) -> void

          def to_hash: -> {
            type: :memory_path_conflict_error,
            conflicting_memory_id: String,
            conflicting_path: String,
            message: String
          }
        end
      end
    end
