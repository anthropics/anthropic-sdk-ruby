module Anthropic
  module Models
    module Beta
      module MemoryStores
        type beta_managed_agents_error =
          Anthropic::BetaInvalidRequestError
          | Anthropic::BetaAuthenticationError
          | Anthropic::BetaBillingError
          | Anthropic::BetaPermissionError
          | Anthropic::BetaNotFoundError
          | Anthropic::BetaRateLimitError
          | Anthropic::BetaGatewayTimeoutError
          | Anthropic::BetaAPIError
          | Anthropic::BetaOverloadedError
          | Anthropic::Beta::MemoryStores::BetaManagedAgentsMemoryPreconditionFailedError
          | Anthropic::Beta::MemoryStores::BetaManagedAgentsMemoryPathConflictError
          | Anthropic::Beta::MemoryStores::BetaManagedAgentsConflictError

        module BetaManagedAgentsError
          extend Anthropic::Internal::Type::Union

          def self?.variants: -> ::Array[Anthropic::Models::Beta::MemoryStores::beta_managed_agents_error]

          def self.new:
            (
              type: :invalid_request_error | "invalid_request_error",
              message: String
            ) -> Anthropic::BetaInvalidRequestError
            | (
              type: :authentication_error | "authentication_error",
              message: String
            ) -> Anthropic::BetaAuthenticationError
            | (
              type: :billing_error | "billing_error",
              message: String
            ) -> Anthropic::BetaBillingError
            | (
              type: :permission_error | "permission_error",
              message: String
            ) -> Anthropic::BetaPermissionError
            | (
              type: :not_found_error | "not_found_error",
              message: String
            ) -> Anthropic::BetaNotFoundError
            | (
              type: :rate_limit_error | "rate_limit_error",
              message: String
            ) -> Anthropic::BetaRateLimitError
            | (
              type: :timeout_error | "timeout_error",
              message: String
            ) -> Anthropic::BetaGatewayTimeoutError
            | (
              type: :api_error | "api_error",
              message: String
            ) -> Anthropic::BetaAPIError
            | (
              type: :overloaded_error | "overloaded_error",
              message: String
            ) -> Anthropic::BetaOverloadedError
            | (
              type: :memory_precondition_failed_error
              | "memory_precondition_failed_error",
              ?message: String
            ) -> Anthropic::Beta::MemoryStores::BetaManagedAgentsMemoryPreconditionFailedError
            | (
              type: :memory_path_conflict_error | "memory_path_conflict_error",
              ?conflicting_memory_id: String,
              ?conflicting_path: String,
              ?message: String
            ) -> Anthropic::Beta::MemoryStores::BetaManagedAgentsMemoryPathConflictError
            | (
              type: :conflict_error | "conflict_error",
              ?message: String
            ) -> Anthropic::Beta::MemoryStores::BetaManagedAgentsConflictError
            | (
              type: Symbol | String,
              ?message: String,
              ?conflicting_memory_id: String,
              ?conflicting_path: String
            ) -> Anthropic::Models::Beta::MemoryStores::beta_managed_agents_error
        end
      end
    end
  end
end
