module Anthropic
  module Models
    module Beta
      module Vaults
        type beta_managed_agents_credential_validation_status =
          :valid | :invalid | :unknown

        module BetaManagedAgentsCredentialValidationStatus
          extend Anthropic::Internal::Type::Enum

          # The credential successfully authenticated against its MCP server.
          VALID: :valid

          # The probe reached the MCP server and was rejected, and a refresh (if attempted) did not recover it.
          INVALID: :invalid

          # The probe could not determine validity — for example, a transport error or a successful refresh that was not re-probed.
          UNKNOWN: :unknown

          def self?.values: -> ::Array[Anthropic::Models::Beta::Vaults::beta_managed_agents_credential_validation_status]
        end
      end
    end
  end
end
