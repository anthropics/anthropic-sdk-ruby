module Anthropic
  module Models
    module Beta
      module Compliance
        type beta_compliance_review_order = :asc | :desc

        module BetaComplianceReviewOrder
          extend Anthropic::Internal::Type::Enum

          # Oldest first.
          ASC: :asc

          # Newest first.
          DESC: :desc

          def self?.values: -> ::Array[Anthropic::Models::Beta::Compliance::beta_compliance_review_order]
        end
      end
    end
  end
end
