module Anthropic
  module Models
    module BetaManagedAgentsDeploymentStatus = Beta::BetaManagedAgentsDeploymentStatus

    module Beta
      type beta_managed_agents_deployment_status = :active | :paused

      module BetaManagedAgentsDeploymentStatus
        extend Anthropic::Internal::Type::Enum

        # The deployment is active and can run sessions. Archived deployments also report this status; check `archived_at` to distinguish them.
        ACTIVE: :active

        # The deployment is paused. Autonomous triggers are suppressed; manual runs are still permitted.
        PAUSED: :paused

        def self?.values: -> ::Array[Anthropic::Models::Beta::beta_managed_agents_deployment_status]
      end
    end
  end
end
