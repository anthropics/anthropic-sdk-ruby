module Anthropic
  module Models
    class BetaManagedAgentsOutcomeEvaluationResource = Beta::BetaManagedAgentsOutcomeEvaluationResource

    module Beta
      type beta_managed_agents_outcome_evaluation_resource =
        {
          completed_at: Time?,
          description: String,
          explanation: String?,
          iteration: Integer,
          outcome_id: String,
          result: String,
          type: :outcome_evaluation
        }

      class BetaManagedAgentsOutcomeEvaluationResource < Anthropic::Internal::Type::BaseModel
        attr_accessor completed_at: Time?

        attr_accessor description: String

        attr_accessor explanation: String?

        attr_accessor iteration: Integer

        attr_accessor outcome_id: String

        attr_accessor result: String

        attr_accessor type: :outcome_evaluation

        def initialize: (
          completed_at: Time?,
          description: String,
          explanation: String?,
          iteration: Integer,
          outcome_id: String,
          result: String,
          ?type: :outcome_evaluation
        ) -> void

        def to_hash: -> {
          completed_at: Time?,
          description: String,
          explanation: String?,
          iteration: Integer,
          outcome_id: String,
          result: String,
          type: :outcome_evaluation
        }
      end
    end
  end
end
