module Anthropic
  module Models
    module BetaDreamingError = Beta::BetaDreamingError

    module Beta
      type beta_dreaming_error =
        Anthropic::BetaInvalidRequestError
        | Anthropic::BetaAuthenticationError
        | Anthropic::BetaBillingError
        | Anthropic::BetaPermissionError
        | Anthropic::BetaNotFoundError
        | Anthropic::BetaRateLimitError
        | Anthropic::BetaGatewayTimeoutError
        | Anthropic::BetaAPIError
        | Anthropic::BetaOverloadedError
        | Anthropic::Beta::BetaTargetStoreHeldError

      module BetaDreamingError
        extend Anthropic::Internal::Type::Union

        type type_ =
          :invalid_request_error
          | :authentication_error
          | :billing_error
          | :permission_error
          | :not_found_error
          | :rate_limit_error
          | :timeout_error
          | :api_error
          | :overloaded_error
          | :conflict_error

        module Type
          extend Anthropic::Internal::Type::Enum

          INVALID_REQUEST_ERROR: :invalid_request_error
          AUTHENTICATION_ERROR: :authentication_error
          BILLING_ERROR: :billing_error
          PERMISSION_ERROR: :permission_error
          NOT_FOUND_ERROR: :not_found_error
          RATE_LIMIT_ERROR: :rate_limit_error
          TIMEOUT_ERROR: :timeout_error
          API_ERROR: :api_error
          OVERLOADED_ERROR: :overloaded_error
          CONFLICT_ERROR: :conflict_error

          def self?.values: -> ::Array[Anthropic::Models::Beta::BetaDreamingError::type_]
        end

        def self?.variants: -> ::Array[Anthropic::Models::Beta::beta_dreaming_error]

        def self.new:
          (
            type: :invalid_request_error | "invalid_request_error",
            message: String
          ) -> Anthropic::BetaInvalidRequestError
          | (
            type: :authentication_error | "authentication_error",
            message: String
          ) -> Anthropic::BetaAuthenticationError
          | (
            type: :billing_error | "billing_error",
            message: String
          ) -> Anthropic::BetaBillingError
          | (
            type: :permission_error | "permission_error",
            message: String
          ) -> Anthropic::BetaPermissionError
          | (
            type: :not_found_error | "not_found_error",
            message: String
          ) -> Anthropic::BetaNotFoundError
          | (
            type: :rate_limit_error | "rate_limit_error",
            message: String
          ) -> Anthropic::BetaRateLimitError
          | (
            type: :timeout_error | "timeout_error",
            message: String
          ) -> Anthropic::BetaGatewayTimeoutError
          | (
            type: :api_error | "api_error",
            message: String
          ) -> Anthropic::BetaAPIError
          | (
            type: :overloaded_error | "overloaded_error",
            message: String
          ) -> Anthropic::BetaOverloadedError
          | (
            type: :conflict_error | "conflict_error",
            ?message: String
          ) -> Anthropic::Beta::BetaTargetStoreHeldError
          | (
            type: Symbol | String,
            ?message: String
          ) -> Anthropic::Models::Beta::beta_dreaming_error
      end
    end
  end
end
