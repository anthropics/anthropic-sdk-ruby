module Anthropic
  module Internal
    module Transport
      class BaseClient
        extend Anthropic::Internal::Util::SorbetRuntimeSupport

        type request_components =
          {
            method: Symbol,
            path: String | ::Array[String],
            query: ::Hash[String, (::Array[String] | String)?]?,
            headers: ::Hash[String, (String
            | Integer
            | ::Array[(String | Integer)?])?]?,
            body: top?,
            unwrap: (Symbol
            | Integer
            | ::Array[(Symbol | Integer)]
            | (^(top arg0) -> top))?,
            page: Class?,
            stream: Class?,
            model: Anthropic::Internal::Type::Converter::input?,
            span_name: String?,
            span_attributes: ::Hash[String, top]?,
            span_created_id: (String | ::Hash[String, Symbol])?,
            span_route: String?,
            span_query: ::Array[String]?,
            span_content_query: ::Array[String]?,
            options: Anthropic::request_opts?
          }
        type request_input =
          {
            method: Symbol,
            url: URI::Generic,
            headers: ::Hash[String, String],
            body: top,
            max_retries: Integer,
            timeout: Float,
            user_header_keys: ::Array[String],
            cast_to: Anthropic::Internal::Type::Converter::input?,
            stream: Class?,
            unwrap: (Symbol
            | Integer
            | ::Array[(Symbol | Integer)]
            | (^(top arg0) -> top))?,
            span_query: ::Array[String]?,
            span_content_query: ::Array[String]?,
            options: ::Hash[Symbol, top],
            middleware: ::Array[Anthropic::Middleware::entry],
            metadata: ::Hash[Symbol, top]
          }

        MAX_REDIRECTS: 20

        PLATFORM_HEADERS: ::Hash[String, String]

        def self.validate!: (
          Anthropic::Internal::Transport::BaseClient::request_components req
        ) -> void

        def self.should_retry?: (
          Integer status,
          headers: ::Hash[String, String]
        ) -> bool

        def self.follow_redirect: (
          Anthropic::Internal::Transport::BaseClient::request_input request,
          status: Integer,
          response_headers: ::Hash[String, String],
          ?span: top?
        ) -> Anthropic::Internal::Transport::BaseClient::request_input

        def self.reap_connection!: (
          Integer | Anthropic::Errors::APIConnectionError status,
          stream: Enumerable[String]?
        ) -> void

        attr_reader base_url: URI::Generic

        attr_reader timeout: Float

        attr_reader max_retries: Integer

        attr_reader initial_retry_delay: Float

        attr_reader max_retry_delay: Float

        attr_reader headers: ::Hash[String, String]

        attr_reader idempotency_header: String?

        # @api private
        attr_reader requester: Anthropic::Internal::Transport::PooledNetRequester

        attr_reader middleware: ::Array[Anthropic::Middleware::entry]

        def initialize: (
          base_url: String,
          ?proxy: (String | URI::Generic)?,
          ?timeout: Float,
          ?max_retries: Integer,
          ?initial_retry_delay: Float,
          ?max_retry_delay: Float,
          ?open_telemetry: Anthropic::Internal::Tracing::client_option?,
          ?headers: ::Hash[String, (String
          | Integer
          | ::Array[(String | Integer)?])?],
          ?idempotency_header: String?,
          ?middleware: Anthropic::Middleware::entry_or_array?,
          ?requester: Anthropic::Internal::Transport::PooledNetRequester?
        ) -> void

        private def auth_headers: -> ::Hash[String, String]

        def open_telemetry_attributes: -> ::Hash[String, String]

        def open_telemetry_content?: -> bool

        # @api private
        attr_reader open_telemetry_max_content_bytes: Integer

        def open_telemetry_tracer: -> top?

        private def open_telemetry_scope: -> String

        private def user_agent: -> String

        private def generate_idempotency_key: -> String

        private def build_request: (
          Anthropic::Internal::Transport::BaseClient::request_components req,
          Anthropic::request_options opts
        ) -> Anthropic::Internal::Transport::BaseClient::request_input

        private def retry_delay: (
          ::Hash[String, String] headers,
          retry_count: Integer
        ) -> Float

        private def provider_middleware: -> Anthropic::Middleware::entry?

        def retry_request?: (
          Integer status,
          headers: ::Hash[String, String]
        ) -> bool

        def send_request: (
          Anthropic::Internal::Transport::BaseClient::request_input request,
          redirect_count: Integer,
          retry_count: Integer,
          send_retry_header: bool,
          ?span: top?
        ) -> [Integer, top, ::Hash[String, String], Enumerable[String]]

        def request: (
          Symbol method,
          String | ::Array[String] path,
          ?query: ::Hash[String, (::Array[String] | String)?]?,
          ?headers: ::Hash[String, (String
          | Integer
          | ::Array[(String | Integer)?])?]?,
          ?body: top?,
          ?unwrap: (Symbol
          | Integer
          | ::Array[(Symbol | Integer)]
          | (^(top arg0) -> top))?,
          ?page: Class?,
          ?stream: Class?,
          ?model: Anthropic::Internal::Type::Converter::input?,
          ?span_name: String?,
          ?span_attributes: ::Hash[String, top]?,
          ?span_created_id: (String | ::Hash[String, Symbol])?,
          ?span_route: String?,
          ?span_query: ::Array[String]?,
          ?span_content_query: ::Array[String]?,
          ?options: Anthropic::request_opts?
        ) -> top

        private def execute_request: (
          Anthropic::Internal::Transport::BaseClient::request_components req,
          ?span: top?
        ) ?{
          (Integer status, ::Hash[String, String] headers) -> void
        } -> top

        def inspect: -> String
      end
    end
  end
end
