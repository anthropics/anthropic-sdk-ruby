module Anthropic
  module Internal
    class TracedStream[Elem]
      include Anthropic::Internal::Type::BaseStream[top, Elem]

      attr_reader streamed_message: top?

      def initialize: (
        Anthropic::Internal::Type::BaseStream[bot, Elem] stream,
        Enumerable[Elem] iterator,
        top? streamed_message
      ) -> void
    end

