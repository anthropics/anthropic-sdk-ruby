      CLIENT_ATTRIBUTES: ::Hash[String, String]

      RESPONSE_HEADER_ATTRIBUTES: ::Hash[String, String]

      type client_option =
        bool
        | {
          tracer_provider: top,
          propagation: bool?,
          traces: (bool | traces_option)?
        }

      type traces_option =
        {
          enabled: bool?,
          content_mode: (:metadata_only | :content | String)?,
          max_content_bytes: Integer?
        }

      type request_option = { conversation_id: String? }

      CLIENT_OPTION_KEYS: ::Array[Symbol]

      TRACES_KEYS: ::Array[Symbol]

      CONTENT_MODES: ::Array[Symbol]

      DEFAULT_MAX_CONTENT_BYTES: Integer

      REQUEST_OPTION_KEYS: ::Array[Symbol]

      CONTENT_QUERY_PARAMETERS: ::Array[String]

      SPAN_ATTRIBUTES: ::Hash[String, ::Hash[Symbol, top]]

      interface _Recorder
        def start_attributes: (
          Anthropic::Internal::Transport::BaseClient client,
          ::Hash[Symbol, top] req
        ) -> ::Hash[String, top]?

        def record: (top span, ::Hash[Symbol, top] result) -> void
      end

      self.@recorders: ::Hash[String?, ::Array[_Recorder]]

      def self.client_option: (
        (::Hash[(Symbol | String), top] | bool)? option
      ) -> ::Hash[Symbol, top]

      def self.request_option: (
        ::Hash[(Symbol | String), top]? option
      ) -> ::Hash[Symbol, top]

      def self.tracer: (::Hash[Symbol, top] option, ?String scope) -> top?

      def self.content?: (::Hash[Symbol, top] option) -> bool

      def self.max_content_bytes: (::Hash[Symbol, top] option) -> Integer

      def self.propagation?: (::Hash[Symbol, top] option) -> bool

      def self.start_api_call_span: (
        top tracer,
        ::Hash[Symbol, top] req,
        propagation: bool
      ) -> top?

      def self.register_recorder: (
        String? span_name,
        _Recorder recorder
      ) -> void

      def self.api_call_span_attributes: (
        Anthropic::Internal::Transport::BaseClient client,
        ::Hash[Symbol, top] req
      ) -> ::Hash[String, top]

      def self.record_send: (
        top span,
        Anthropic::Internal::Transport::BaseClient client,
        ::Hash[Symbol, top] request,
        URI::Generic url
      ) -> void

      def self.set_response_attributes: (
        top span,
        String? span_name,
        Anthropic::Internal::Type::BaseModel | ::Hash[Symbol, top] response
      ) -> void

      def self.inject: (top span) -> ::Hash[String, String]

      def self.trace_header_names: (top? span) -> ::Array[String]

      def self.end_api_call_span: (top span, ::Hash[Symbol, top] result) -> void

      def self.end_api_call_span_when_stream_ends: (
        top span,
        Anthropic::Internal::Type::BaseStream[bot, top] stream,
        ::Hash[Symbol, top] result
      ) -> Anthropic::Internal::Type::BaseStream[bot, top]

      def self.set_error_status: (top span, Exception error) -> void

      private def self.option_hash: (
        top option,
        ::Array[Symbol] keys,
        String name,
        String expected
      ) -> ::Hash[Symbol, top]

      private def self.plain: (top value) -> String

      private def self.environment_option: -> ::Hash[Symbol, top]

      private def self.environment_content_mode: -> Symbol

      private def self.environment_max_content_bytes: -> Integer?

      private def self.set_response_status_code: (
        top span,
        ::Hash[Symbol, top] result
      ) -> void

      private def self.set_created_id: (
        top span,
        ::Hash[Symbol, top] result
      ) -> void

      private def self.set_response_header_attributes: (
        top span,
        ::Hash[Symbol, top] result
      ) -> void

      private def self.record_result: (
        top span,
        ::Hash[Symbol, top] result
      ) -> void

      private def self.recorders: (String? span_name) -> ::Array[_Recorder]

      private def self.recording: (String? span_name) { -> top } -> top

      private def self.url_attributes: (
        Anthropic::Internal::Transport::BaseClient client,
        URI::Generic url,
        ::Array[String] query_names,
        ::Array[String] content_names
      ) -> ::Hash[String, String]

      private def self.request_attributes: (
        Anthropic::Internal::Transport::BaseClient client,
        ::Hash[Symbol, top] req
      ) -> ::Hash[String, top]

      private def self.dig: (top data, ::Array[Symbol] path) -> top

      private def self.attribute_value: (
        top value,
        Symbol | ::Array[Symbol] `type`
      ) -> top

      private def self.header_value: (
        String? value,
        Symbol | ::Array[Symbol] `type`
      ) -> top

      private def self.iterate_and_end_span: (
        Enumerator[top] source,
        top span,
        bool events
      ) -> Enumerator[top]

      private def self.error_type: (StandardError error) -> String
    end
  end
end
