module Anthropic
  module Internal
    class ReportPageCursor[Elem]
      include Anthropic::Internal::Type::BasePage[Elem]

      attr_accessor data: ::Array[Elem]?

      attr_accessor next_page_: String?

      attr_accessor has_more: bool

      attr_accessor data_refreshed_at: Time?

      def inspect: -> String
    end
  end
end
